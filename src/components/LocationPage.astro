---
import { imageVariant } from '../lib/images';
import { locations } from '../lib/content';
import { url, richHtml } from '../lib/urls';
import DetailSections from './DetailSections.astro';
import ContentLink from './ContentLink.astro';
import { departmentHoursHtml, directionsHref, hasHours, sidebarWithoutContact, telHref, type ClinicDepartment } from '../lib/departments';
interface Props { slug: string }
const location = locations.find(p => p.slug === Astro.props.slug);
if (!location) throw new Error(`Unknown location: ${Astro.props.slug}`);
const heroImage = imageVariant(location.image.src, 1280, 800);
const departments: ClinicDepartment[] = (location as { departments?: ClinicDepartment[] }).departments ?? [];
const departmentHours = departments.some(hasHours) ? departmentHoursHtml(departments) : '';
const sections = departmentHours ? location.sections.map(section => section.title === 'Hours of operation' ? { ...section, html: departmentHours } : section) : location.sections;
---
<section class="loc-hero">
  <div class="loc-hero-bg"><img src={url(heroImage)} width="1280" height="800" alt={location.image.alt} fetchpriority="high" decoding="async" /><div class="loc-hero-overlay"></div></div>
  <div class="container loc-hero-inner">
    <a href={url('/locations/index.html')} class="provider-breadcrumb"><span class="material-symbols-rounded">arrow_back</span> All Locations</a>
    {location.tag && <span class="loc-hero-tag">{location.tag}</span>}
    <h1 class="loc-hero-title">{location.title}</h1>
    {location.subtitle && <p class="loc-hero-sub">{location.subtitle}</p>}
    {location.metaHtml && <div class="loc-hero-meta" set:html={richHtml(location.metaHtml)} />}
    {location.actions.length > 0 && <div class="loc-hero-actions">{location.actions.map(link => <ContentLink link={link} />)}</div>}
  </div>
</section>
<section class="loc-detail"><div class="container loc-detail-inner">
  <div class="loc-detail-main"><DetailSections sections={sections} /></div>
  {departments.length ? <aside class="provider-sidebar">
    {departments.map(department => <div class="sidebar-card sidebar-card--department">
      <h3 class="sidebar-card-title"><span class="material-symbols-rounded">{department.name === 'Radiation Oncology' ? 'radiology' : 'biotech'}</span> {department.name}</h3>
      <p class="sidebar-contact-item">{department.location && <>{department.location}<br /></>}{department.street}<br />{department.city}</p>
      {department.phone && <p class="sidebar-contact-item"><strong>Phone:</strong> <a href={telHref(department.phone)}>{department.phone}</a></p>}
      {department.fax && <p class="sidebar-contact-item"><strong>Fax:</strong> {department.fax}</p>}
      <a href={directionsHref(department)} class="btn btn--primary btn--full"><span class="material-symbols-rounded">directions</span> Get Directions</a>
    </div>)}
    <Fragment set:html={richHtml(sidebarWithoutContact(location.sidebarHtml))} />
  </aside> : <aside class="provider-sidebar" set:html={richHtml(location.sidebarHtml)} />}
</div></section>
{location.mapPlaceholder && <section class="loc-map-section"><div class="loc-map-placeholder"><span class="material-symbols-rounded">map</span><p>Interactive map</p></div></section>}
