---
import SharedContent from './SharedContent.astro';
import ProviderCall from './ProviderCall.astro';
import type {ClinicCall} from '../lib/provider-calls';
interface Props { contact: string; calls: ClinicCall[] }
const { contact, calls } = Astro.props;
---
<aside class="provider-sidebar">
  <SharedContent name={contact} omitClinicNumbers />
  {calls.length > 0 && <div class="sidebar-card sidebar-card--dark">
    <h3 class="sidebar-card-title"><span class="material-symbols-rounded" aria-hidden="true">calendar_today</span> Schedule a Visit</h3>
    <p class="sidebar-card-desc">New and existing patients can request an appointment over the phone.</p>
    <ProviderCall calls={calls} full />
  </div>}
</aside>
