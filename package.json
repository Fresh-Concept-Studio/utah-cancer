{
  "name": "utah-cancer-specialists",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "build:production": "SITE_URL=https://utahcancer.com BASE_PATH=/ SITE_INDEXABLE=true astro build",
    "preview": "astro preview --host 127.0.0.1 --port 4323",
    "check": "astro check",
    "test": "node --test tests/site.test.mjs tests/contact-form.test.mjs tests/analytics.test.mjs",
    "verify": "npm run check && npm run build && npm test",
    "verify:production": "npm run verify && npm run build:production && SITE_URL=https://utahcancer.com BASE_PATH=/ SITE_INDEXABLE=true npm test",
    "test:migration": "node --test tests/migration.test.mjs",
    "cms:studio": "npm --prefix studio run dev",
    "cms:build": "npm --prefix studio run build",
    "cms:deploy": "npm --prefix studio run deploy",
    "cms:export": "tsx scripts/export-sanity-content.ts",
    "cms:import": "npm run cms:export && studio/node_modules/.bin/sanity dataset import .sanity/initial-content.ndjson --dataset production --replace --project-id spba0u9p"
  },
  "dependencies": {
    "@sanity/client": "8.6.2",
    "astro": "7.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/node": "^22.20.3",
    "acorn": "^8.18.0",
    "cheerio": "^1.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
