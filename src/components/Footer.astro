---
import { url } from '../lib/urls';
---
<footer class="footer">
    <div class="container footer-inner">
      <div class="footer-left">
        <img src={url("/images/ucs-logo-white.svg")} alt="Utah Cancer Specialists" class="footer-logo">
        <h3 class="footer-tagline">Your health, our priority</h3>
        <p class="footer-tagline-desc">Experience personalized care and advanced treatments. Schedule your consultation today for a healthier tomorrow.</p>
      </div>
      <div class="footer-right">
        <div class="footer-columns">
          <div class="footer-col">
            <h4 class="footer-col-title">About Us</h4>
            <ul class="footer-links">
              <li><a href={url("/about.html")}>Our Mission</a></li>
            </ul>
          </div>
          <div class="footer-col">
            <h4 class="footer-col-title">Patient Care</h4>
            <ul class="footer-links">
              <li><a href={url("/newly-diagnosed.html")}>Newly Diagnosed</a></li>
              <li><a href={url("/telehealth.html")}>Telehealth</a></li>
              <li><a href={url("/patient-education.html")}>Patient Education</a></li>
              <li><a href={url("/patient-resources.html")}>Patient Resources</a></li>
            </ul>
          </div>
          <div class="footer-col">
            <h4 class="footer-col-title">Research</h4>
            <ul class="footer-links">
              <li><a href={url("/clinical-trials.html")}>Clinical Trials</a></li>
              <li><a href={url("/programs-and-services.html")}>Programs</a></li>
              <li><a href="https://utahcancer.com/jobs/" target="_blank" rel="noopener">Careers</a></li>
              <li><a href={url("/contact.html")}>Contact</a></li>
            </ul>
          </div>
        </div>
        <div class="footer-contact">
          <p class="footer-address">10808 S. River Front Pkwy., Ste. 400<br>South Jordan, UT 84095</p>
          <div class="footer-contact-info">
            <p><span class="footer-contact-label">Phone:</span> <a href="tel:8012690231">801.269.0231</a></p>
            <p><span class="footer-contact-label">Email:</span> <a href="mailto:info@utcancer.com">info@utcancer.com</a></p>
          </div>
          <div class="footer-social">
            <a href="https://www.facebook.com/utahcancerspecialists" target="_blank" rel="noopener" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
            <a href="https://www.instagram.com/utahcancerspecialists/" target="_blank" rel="noopener" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
            <a href="https://www.linkedin.com/company/utahcancer-specialists" target="_blank" rel="noopener" aria-label="LinkedIn"><i class="fab fa-linkedin-in"></i></a>
            <a href="https://www.youtube.com/@UTCancerSpecialists" target="_blank" rel="noopener" aria-label="YouTube"><i class="fab fa-youtube"></i></a>
          </div>
        </div>
      </div>
    </div>
    <div class="container">
      <div class="footer-bottom">
        <p>© Utah Cancer Specialists. All rights reserved.</p>
        <a href="https://utahcanceronline.ci.healthpay24.cloud/account/login" target="_blank" rel="noopener" class="footer-paperless"><span class="material-symbols-rounded">eco</span> Go paperless · Enroll in eStatements <span class="material-symbols-rounded">arrow_outward</span></a>
      </div>
    </div>
  </footer>
