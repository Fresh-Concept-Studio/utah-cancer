            <a href="https://www.linkedin.com/company/utahcancer-specialists" target="_blank" rel="noopener" aria-label="LinkedIn"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 3.5A2.5 2.5 0 1 1 5 8a2.5 2.5 0 0 1 0-4.5ZM3 9h4v12H3V9Zm6 0h4v1.7c1-1.3 2.4-2.1 4.2-2.1 3.2 0 4.8 2.1 4.8 6V21h-4v-5.7c0-1.8-.6-3-2.3-3-1.9 0-2.7 1.3-2.7 3.4V21H9V9Z" /></svg></a>
