---
import { url } from '../lib/urls';
---
<section class="providers-hero">
    <div class="container">
      <h1 class="providers-hero-title">Telehealth</h1>
      <p class="providers-hero-desc">Connecting with your physician through technology — virtual, home-based care without a disruption in treatment.</p>
    </div>
  </section>

  <div class="container">
    <div class="hero-bridge">
      <img src={url("/images/generated/telehealth-hero.png")} alt="A laptop on a sunlit kitchen table set up for a virtual care visit at home">
    </div>
  </div>

  <section class="th-how">
    <div class="container">
      <div class="th-how-header">
        <span class="th-eyebrow">How it works</span>
        <h2 class="th-how-title">Care that meets you at home, in three simple steps.</h2>
        <p class="th-how-intro">Telehealth lets you connect with your physician or advanced care practitioner from your smartphone, tablet, or computer — no downloads, no special software, no disruption to your treatment.</p>
      </div>

      <div class="th-steps">
        <div class="th-step">
          <div class="th-step-icon">
            <span class="material-symbols-rounded">smartphone</span>
            <span class="th-step-num">1</span>
          </div>
          <div class="th-step-label">Step 01</div>
          <h3 class="th-step-title">Receive Your Link</h3>
          <p class="th-step-desc">Your clinic sends a clickable link to your smartphone, tablet, or email before your appointment.</p>
        </div>
        <div class="th-step">
          <div class="th-step-icon">
            <span class="material-symbols-rounded">videocam</span>
            <span class="th-step-num">2</span>
          </div>
          <div class="th-step-label">Step 02</div>
          <h3 class="th-step-title">Connect</h3>
          <p class="th-step-desc">Click the link at your scheduled time. No downloads or special software required — just one tap to join.</p>
        </div>
        <div class="th-step">
          <div class="th-step-icon">
            <span class="material-symbols-rounded">stethoscope</span>
            <span class="th-step-num">3</span>
          </div>
          <div class="th-step-label">Step 03</div>
          <h3 class="th-step-title">Your Visit</h3>
          <p class="th-step-desc">Meet face-to-face with your provider, discuss your care, and ask questions from the comfort of home.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="th-faq-section">
    <div class="container">
      <div class="th-faq-wrap">
        <h2 class="th-faq-title">Common Questions</h2>
        <div class="sd-faq">
          <details class="sd-faq-item"><summary>What equipment do I need?</summary><p>A smartphone, tablet, or computer with a camera and microphone. Most modern devices have everything you need built in.</p></details>
          <details class="sd-faq-item"><summary>Is telehealth covered by insurance?</summary><p>Most insurance plans cover telehealth visits. Our patient advocates can verify your coverage before your appointment.</p></details>
          <details class="sd-faq-item"><summary>What types of visits can be done via telehealth?</summary><p>Follow-up consultations, treatment discussions, symptom checks, lab result reviews, and survivorship visits are all well-suited for telehealth. Your care team will let you know if an in-person visit is needed.</p></details>
          <details class="sd-faq-item"><summary>Is my telehealth visit private and secure?</summary><p>Yes. All telehealth visits use HIPAA-compliant, encrypted video connections to protect your privacy.</p></details>
        </div>
      </div>
    </div>
  </section>
