---
import { pageEditor } from '../lib/page-content';
const edit = pageEditor(Astro.props.page);
import { url } from '../lib/urls';
import { clinicalTrials } from '../lib/content';
import { groupTrials } from '../lib/clinical-trials';
const categories = groupTrials(clinicalTrials);
const trialCount = clinicalTrials.length;
const trialCountLabel = `${trialCount} ${trialCount === 1 ? 'trial' : 'trials'}`;
---
<section class="sd-hero">
    <div class="sd-hero-bg"><img src={url(edit.image("image-561ca38b27", "/images/specialty-lung-clinical-hero.webp"))} width="1200" height="675" alt={edit.imageAlt("image-561ca38b27", "")} fetchpriority="high" decoding="async"><div class="sd-hero-overlay"></div></div>
    <div class="container sd-hero-inner">
      <span class="sd-hero-tag">{edit.text("text-e2f6d61a65", "UCS Clinical Research")}</span>
      <h1 class="sd-hero-title">{edit.text("text-fc2f60cdf5", "Late-Phase Clinical Trials")}</h1>
      <p class="sd-hero-sub">{edit.text("text-5c24775a49", "Phase II and III research bringing the latest therapeutic advances directly to patients and communities across the Intermountain West.")}</p>
      <div class="sd-hero-actions">
        <a href="#active-trials" class="btn btn--white">{edit.text("text-d3e4690de2", "Explore Active Trials ")}<span class="material-symbols-rounded">arrow_downward</span></a>
        <a href={url(edit.text("link-0567610c7e", "mailto:research@utahcancer.com"))} class="btn btn--outline-dark"><span class="material-symbols-rounded">mail</span>{edit.text("text-4a79cd388b", " Contact Research")}</a>
      </div>
    </div>
  </section>

  <div class="lp-breadcrumbs">
    <div class="container lp-breadcrumbs-inner">
      <a href={url(edit.text("link-ac92c0ebdf", "/clinical-trials.html"))}>{edit.text("text-65221b74ce", "Clinical Trials")}</a>
      <span class="material-symbols-rounded">chevron_right</span>
      <span>{edit.text("text-65cdaaab89", "Late-Phase Trials")}</span>
    </div>
  </div>

  <main>
    <section class="lp-intro">
      <div class="container lp-intro-grid">
        <div>
          <span class="lp-eyebrow">{edit.text("text-047bdcb1fd", "Phase II–III Research Program")}</span>
          <h2 class="lp-title">{edit.text("text-c3a8994e60", "Making clinical trials more accessible to every community we serve.")}</h2>
          <p class="lp-lead">{edit.text("text-fb5d8663f5", "Our Utah Cancer Specialists Clinical Research Program travels throughout our many locations in Utah to bring pioneering and impactful health care research directly to our communities and patients. We know a diagnosis of cancer can be a stressful time for you and your family. Let us assist you in enrolling in a clinical trial and guide you through every step of the process.")}</p>
        </div>
        <aside class="lp-summary-card">
          <span class="material-symbols-rounded">science</span>
          <h2>{edit.text("text-e21e95bec2", "About the UCS Cancer Research Program")}</h2>
          <p>{edit.text("text-5066453385", "We are committed to bringing the latest breakthrough cancer treatments to our patients. We manage more than 50 active clinical trials on an ongoing basis, with access across our clinics, including rural communities.")}</p>
          <div class="lp-summary-contact">
            <a href={url(edit.text("link-3277871004", "tel:8012816864"))}><span class="material-symbols-rounded">phone</span>{edit.text("text-fcc72d26e9", " 801.281.6864")}</a>
            <a href={url(edit.text("link-0567610c7e-1", "mailto:research@utahcancer.com"))}><span class="material-symbols-rounded">mail</span>{edit.text("text-d081793d07", " research@utahcancer.com")}</a>
          </div>
        </aside>
      </div>
    </section>

    <section class="lp-offerings">
      <div class="container">
        <div class="lp-section-header">
          <span class="lp-eyebrow">{edit.text("text-f74d2ae87d", "Our clinical trial offerings")}</span>
          <h2 class="lp-section-title">{edit.text("text-8476ab1d93", "Research capabilities built around patient access.")}</h2>
        </div>
        <div class="lp-offerings-grid">
          <article class="lp-offering">
            <div class="lp-offering-icon"><span class="material-symbols-rounded">biotech</span></div>
            <h3>{edit.text("text-1018610888", "Biologics / Immuno-Oncology")}</h3>
            <p>{edit.text("text-9437fb57d7", "Utilizing the latest technologies in precision medicine to target cancer.")}</p>
          </article>
          <article class="lp-offering">
            <div class="lp-offering-icon"><span class="material-symbols-rounded">radiology</span></div>
            <h3>{edit.text("text-ae33d37c5f", "Theranostics / PET / CT")}</h3>
            <p>{edit.text("text-26e6334703", "Antibody- and antigen-targeted therapy used to deliver a radioactive payload to cancer cells.")}</p>
          </article>
          <article class="lp-offering">
            <div class="lp-offering-icon"><span class="material-symbols-rounded">local_hospital</span></div>
            <h3>{edit.text("text-118babcc2c", "Inpatient Capabilities")}</h3>
            <p>{edit.text("text-eabda1a024", "Partnering with hospitals in our community to make promising research more accessible.")}</p>
          </article>
        </div>
      </div>
    </section>

    <section class="lp-trials" id="active-trials">
      <div class="container">
        <div class="lp-section-header">
          <span class="lp-eyebrow">{edit.text("text-9c1c6f7afa", "Phase II / III Research Program")}</span>
          <h2 class="lp-section-title">{edit.text("text-8ab1c2475e", "Active Clinical Trials")}</h2>
          <p class="lp-section-sub"><span id="trial-count">{trialCountLabel}</span>{edit.text("text-37d2ef4a28", " are currently listed. Select a cancer type to narrow the results.")}</p>
        </div>

        <div class="lp-filter-wrap">
          <span class="lp-filter-label">{edit.text("text-7bc90c8f72", "Filter by cancer type")}</span>
          <div class="lp-filters" role="group" aria-label="Filter active trials by cancer type">
            <button class="lp-filter is-active" type="button" data-filter="all" aria-pressed="true">All</button>
            {categories.map(category => <button class="lp-filter" type="button" data-filter={category.id} aria-pressed="false">{category.title}</button>)}
          </div>
        </div>

        {categories.map(category => (
          <div class="lp-trial-section" id={`trials-${category.id}`} data-category={category.id}>
            <h3 class="lp-category-title">{category.title}</h3>
            <div class="lp-trial-list">
              {category.trials.map(trial => (
                <article class="lp-trial-card">
                  <div class="lp-trial-top">
                    <a class="lp-trial-title" href={trial.studyUrl || `https://clinicaltrials.gov/study/${trial.nctId}`} target="_blank" rel="noopener">{trial.title}</a>
                    <span class="lp-status">{trial.statusLabel}</span>
                  </div>
                  <div class="lp-protocol">Protocol: {trial.nctId}</div>
                  <p class="lp-trial-desc">{trial.description}</p>
                  <div class="lp-trial-footer">
                    {trial.contactName && <span><span class="material-symbols-rounded">person</span> {trial.contactName}</span>}
                    {trial.phone && <a href={`tel:${trial.phone.replace(/[^+\d]/g, '')}`}><span class="material-symbols-rounded">phone</span> {trial.phone}</a>}
                    {trial.email && <a href={`mailto:${trial.email}`}><span class="material-symbols-rounded">mail</span> {trial.email}</a>}
                    {(trial.pdfAssetUrl || trial.pdfUrl) && <a href={trial.pdfAssetUrl || trial.pdfUrl} target="_blank" rel="noopener"><span class="material-symbols-rounded">picture_as_pdf</span> {trial.pdfLabel || 'View PDF'}</a>}
                  </div>
                </article>
              ))}
            </div>
          </div>
        ))}
        {!trialCount && <p>No clinical trials are currently listed. Please contact the research team for information.</p>}

        <p class="lp-source-note">{edit.text("text-86caab6cbb", "Trial availability and eligibility can change. Review the linked ClinicalTrials.gov record and contact the UCS research team for the most current enrollment information.")}</p>
      </div>
    </section>
  </main>
