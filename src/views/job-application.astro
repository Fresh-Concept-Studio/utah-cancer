---
import { pageEditor } from '../lib/page-content';
const edit = pageEditor(Astro.props.page);
import { contactForm } from '../data/contact';
import { url } from '../lib/urls';

const endpoint = `${contactForm.serviceUrl}/${contactForm.endpointId}`;
const states = ['AL','AK','AZ','AR','CA','CO','CT','DE','FL','GA','HI','ID','IL','IN','IA','KS','KY','LA','ME','MD','MA','MI','MN','MS','MO','MT','NE','NV','NH','NJ','NM','NY','NC','ND','OH','OK','OR','PA','RI','SC','SD','TN','TX','UT','VT','VA','WA','WV','WI','WY'];
---

<section class="application-hero">
  <div class="container application-hero-inner">
    <div>
      <a class="application-back" href={url(edit.text("link-02c83a4128", "/careers/"))}><span class="material-symbols-rounded" aria-hidden="true">arrow_back</span>{edit.text("text-10b34387a2", " Careers")}</a>
      <span class="application-eyebrow">{edit.text("text-986d6ff8e1", "Careers at Utah Cancer Specialists")}</span>
      <h1>{edit.text("text-050110a104", "Employment application")}</h1>
      <p>{edit.text("text-629dd6a9f3", "Tell us about your experience and the position that interests you. Fields marked with an asterisk are required.")}</p>
    </div>
    <div class="application-hero-note">
      <span class="material-symbols-rounded" aria-hidden="true">description</span>
      <p>{edit.text("text-ce1fb6d2f2", "Have your résumé ready before you begin. Accepted formats include PDF, Word, text, and common image files.")}</p>
    </div>
  </div>
</section>

<section class="application-section" aria-labelledby="application-heading">
  <div class="container application-layout">
    <aside class="application-intro">
      <span class="application-eyebrow application-eyebrow--blue">{edit.text("text-d33512842d", "Apply to join UCS")}</span>
      <h2 id="application-heading">{edit.text("text-e3b6f123af", "Your next step starts here.")}</h2>
      <p>{edit.text("text-50aeaf3263", "This application preserves the information requested by the previous UCS employment form. Please do not include medical or patient information.")}</p>
      <p>{edit.text("text-e770e6935a", "Utah Cancer Specialists is an equal opportunity employer.")}</p>
    </aside>

    <form class="application-form" action={endpoint} method="post" enctype="multipart/form-data">
      <input type="hidden" name="_subject" value="Utah Cancer Specialists — employment application" />
      <input type="hidden" name="_template" value="table" />
      <input type="hidden" name="_next" value="https://utahcancer.com/job-application/?submitted=1" />
      <div class="application-honeypot" aria-hidden="true"><label>Leave this field blank<input type="text" name="_honey" tabindex="-1" autocomplete="off" /></label></div>

      <div class="application-success" data-application-success role="status" tabindex="-1" hidden>
        <span class="material-symbols-rounded" aria-hidden="true">check_circle</span>
        <div><strong>Thank you for applying.</strong><br />Your application was submitted to the Utah Cancer Specialists team.</div>
      </div>

      <fieldset>
        <legend>Position and contact information</legend>
        <label class="application-full">Job applying for <span aria-hidden="true">*</span><input name="job_applying_for" type="text" required maxlength="160" /></label>
        <label>First name <span aria-hidden="true">*</span><input name="first_name" type="text" autocomplete="given-name" required maxlength="80" /></label>
        <label>Last name <span aria-hidden="true">*</span><input name="last_name" type="text" autocomplete="family-name" required maxlength="80" /></label>
        <label>Email <span aria-hidden="true">*</span><input name="email" type="email" autocomplete="email" required maxlength="254" /></label>
        <label>Phone <span aria-hidden="true">*</span><input name="phone" type="tel" autocomplete="tel" required maxlength="40" /></label>
        <label class="application-full">Who referred you?<input name="referral" type="text" maxlength="160" placeholder="Name (optional)" /></label>
      </fieldset>

      <fieldset>
        <legend>Address</legend>
        <label class="application-full">Street address<input name="street_address" type="text" autocomplete="street-address" maxlength="200" /></label>
        <label>City<input name="city" type="text" autocomplete="address-level2" maxlength="100" /></label>
        <label>State<select name="state" autocomplete="address-level1"><option value="">Select a state</option>{states.map(state => <option value={state}>{state}</option>)}</select></label>
        <label>Postal code<input name="postal_code" type="text" autocomplete="postal-code" maxlength="20" /></label>
      </fieldset>

      <fieldset>
        <legend>Availability and employment</legend>
        <label>Date you can start<input name="start_date" type="date" /></label>
        <label>Desired salary<input name="desired_salary" type="text" maxlength="80" placeholder="For example, 22/hour" /></label>
        <div class="application-choice application-full"><span>Are you related to a current UCS employee?</span><label><input name="related_employee" type="radio" value="Yes" /> Yes</label><label><input name="related_employee" type="radio" value="No" /> No</label></div>
        <div class="application-choice application-full"><span>If you are currently employed, may we call your present employer for a reference?</span><label><input name="call_present_employer" type="radio" value="Yes" /> Yes</label><label><input name="call_present_employer" type="radio" value="No" /> No</label></div>
        <div class="application-choice application-full"><span>Have you applied to this organization before?</span><label><input name="applied_before" type="radio" value="Yes" /> Yes</label><label><input name="applied_before" type="radio" value="No" /> No</label></div>
        <label>If so, when?<input name="applied_when" type="date" /></label>
        <div class="application-choice application-full"><span>Are you legally authorized to work in the United States?</span><label><input name="authorized_to_work" type="radio" value="Yes" /> Yes</label><label><input name="authorized_to_work" type="radio" value="No" /> No</label></div>
        <div class="application-choice application-full"><span>Have you been convicted of any crime other than minor traffic violations during the last seven years? A criminal record does not automatically bar employment.</span><label><input name="convicted_last_seven_years" type="radio" value="Yes" /> Yes</label><label><input name="convicted_last_seven_years" type="radio" value="No" /> No</label></div>
        <label class="application-full">If yes, briefly state the circumstances<textarea name="conviction_circumstances" rows="4" maxlength="2000"></textarea></label>
        <div class="application-choice application-full"><span>Are you capable of performing, with or without reasonable accommodation, the essential functions of the job for which you applied?</span><label><input name="essential_functions" type="radio" value="Yes" /> Yes</label><label><input name="essential_functions" type="radio" value="No" /> No</label></div>
        <div class="application-choice application-full"><span>Do you have a current driver’s license?</span><label><input name="drivers_license" type="radio" value="Yes" /> Yes</label><label><input name="drivers_license" type="radio" value="No" /> No</label></div>
      </fieldset>

      <fieldset>
        <legend>Résumé</legend>
        <label class="application-full">Upload résumé <span aria-hidden="true">*</span><input name="attachment" type="file" required accept=".pdf,.doc,.docx,.docm,.dotx,.dotm,.docb,.html,.txt,.rtf,.jpg,.jpeg,.png,.gif" /><small>PDF, Word, text, HTML, JPG, PNG, or GIF.</small></label>
      </fieldset>

      <p class="application-required">* Required fields</p>
      <button type="submit" class="btn btn--primary"><span class="material-symbols-rounded" aria-hidden="true">send</span> Submit application</button>
    </form>
  </div>
</section>
