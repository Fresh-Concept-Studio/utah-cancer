---
import defaultJobs from '../data/jobs.json';
import { pageEditor } from '../lib/page-content';
const edit = pageEditor(Astro.props.page);
import { url } from '../lib/urls';

const applicationUrl = url('/job-application/');

const jobs: typeof defaultJobs = Astro.props.page.jobs ?? defaultJobs;
---

<section class="careers-hero">
  <div class="container careers-hero-grid">
    <div class="careers-hero-copy">
      <span class="careers-eyebrow">{edit.text("text-986d6ff8e1", "Careers at Utah Cancer Specialists")}</span>
      <h1>{edit.text("text-cb5b69a9d7", "Make a difference where care feels personal.")}</h1>
      <p>{edit.text("text-652f034b3f", "Join a team committed to helping patients and families find a clear path through cancer treatment, close to home.")}</p>
      <div class="careers-hero-actions">
        <a href="#openings" class="btn btn--white">{edit.text("text-780e706b16", "View open positions ")}<span class="material-symbols-rounded">arrow_downward</span></a>
        <a href={applicationUrl} class="careers-text-link">{edit.text("text-5089c2f24f", "Start an application ")}<span class="material-symbols-rounded">arrow_forward</span></a>
      </div>
    </div>
    <figure class="careers-hero-photo">
      <img src={url(edit.image("image-0c89bb1083", "/images/team-ucs-group-960.webp"))} width="960" height="640" alt={edit.imageAlt("image-0c89bb1083", "Utah Cancer Specialists team members together outdoors")} fetchpriority="high" decoding="async" />
      <figcaption><strong>{edit.text("text-0732259d24", "One team.")}</strong>{edit.text("text-5193a030af", " Many ways to make care better.")}</figcaption>
    </figure>
  </div>
</section>

<section class="careers-intro" aria-labelledby="careers-intro-heading">
  <div class="container careers-intro-grid">
    <div>
      <span class="careers-eyebrow careers-eyebrow--blue">{edit.text("text-eb9dd4b628", "Work with purpose")}</span>
      <h2 id="careers-intro-heading">{edit.text("text-725ced202d", "Your work becomes part of someone’s care story.")}</h2>
    </div>
    <div class="careers-intro-copy">
      <p>{edit.text("text-e786482ecc", "Every UCS role contributes to the patient experience. Our nurses, pharmacy teams, patient advocates, records staff, outreach specialists, and front-office teams work together to make expert cancer care easier to reach and navigate.")}</p>
      <p>{edit.text("text-bfcc1703c8", "Explore the current openings below. Each listing includes the role’s core responsibilities and qualifications.")}</p>
    </div>
    <div class="careers-figure" aria-label={`${jobs.length} current openings`}>
      <span>{String(jobs.length).padStart(2, '0')}</span>
      <small>{edit.text("text-4fc0e2bc80", "Current")}<br />{edit.text("text-89107bc05d", "openings")}</small>
    </div>
  </div>
</section>

<section class="careers-openings" id="openings" aria-labelledby="openings-heading">
  <div class="container careers-openings-layout">
    <header class="careers-openings-header">
      <span class="careers-eyebrow careers-eyebrow--blue">{edit.text("text-4de966a2be", "Open positions")}</span>
      <h2 id="openings-heading">{edit.text("text-c3090d04f6", "Find your place on the team.")}</h2>
      <p>{edit.text("text-56e7ba78ef", "Select a position to review its responsibilities and qualifications.")}</p>
      <div class="careers-equal-opportunity">
        <span class="material-symbols-rounded" aria-hidden="true">diversity_3</span>
        <p>{edit.text("text-e770e6935a", "Utah Cancer Specialists is an equal opportunity employer.")}</p>
      </div>
    </header>

    <div class="careers-jobs">
      {jobs.map((job, index) => (
        <details class="career-job">
          <summary>
            <span class="career-job-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <span class="career-job-heading">
              <strong>{job.title}</strong>
              <span>{job.location} <i>·</i> {job.schedule}</span>
            </span>
            <span class="career-job-toggle material-symbols-rounded" aria-hidden="true">add</span>
          </summary>
          <div class="career-job-body">
            <p class="career-job-summary">{job.summary}</p>
            <div class="career-job-meta"><span>{job.status}</span><span>{job.schedule}</span><span>{job.location}</span></div>
            <div class="career-job-columns">
              <div>
                <h3>{edit.text("text-337d9698e1", "What you’ll do")}</h3>
                <ul>{(job.responsibilities || []).map(item => <li>{item}</li>)}</ul>
              </div>
              <div>
                <h3>{edit.text("text-58a0ce009d", "What you’ll bring")}</h3>
                <ul>{(job.qualifications || []).map(item => <li>{item}</li>)}</ul>
              </div>
            </div>
            <a href={`${applicationUrl}?position=${encodeURIComponent(job.title)}`} class="btn btn--primary btn--compact">{edit.text("text-a33297fa6c", "Apply for this role ")}<span class="material-symbols-rounded">arrow_forward</span></a>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<section class="careers-apply" aria-labelledby="careers-apply-heading">
  <div class="container careers-apply-inner">
    <div>
      <span class="careers-eyebrow">{edit.text("text-ffdf59064d", "Ready to apply?")}</span>
      <h2 id="careers-apply-heading">{edit.text("text-380b4b7c43", "Take the next step with UCS.")}</h2>
    </div>
    <div>
      <p>{edit.text("text-de1662d592", "Use the secure employment application to share your experience and the position that interests you. Openings can change as roles are filled.")}</p>
      <a href={applicationUrl} class="btn btn--white">{edit.text("text-790f88c503", "Open employment application ")}<span class="material-symbols-rounded">arrow_forward</span></a>
    </div>
  </div>
</section>
