    {
      "key": "text-d802926348",
      "label": "Heading",
      "section": "Pinpoint accuracy. Maximum precision.",
      "value": "Pinpoint accuracy. Maximum precision."
    },
    {
      "key": "text-040354e852",
      "label": "Paragraph",
      "section": "Pinpoint accuracy. Maximum precision.",
      "value": "The TrueBeam system enables a radically different approach to cancer treatment with image-guided radiotherapy. Developed from the ground up to deliver powerful cancer treatments with pinpoint accuracy, the system features a 120-leaf multileaf collimator that shapes the radiation beam to match the three-dimensional shape of each tumor."
    },
    {
      "key": "text-fbe53305c6",
      "label": "Paragraph",
      "section": "Pinpoint accuracy. Maximum precision.",
      "value": "Cone-beam CT capability reduces radiation exposure during imaging, while real-time imaging ensures targeting accuracy measured in millimeters. Gated respiration synchronization allows precise treatment of lung cancer and other motion-sensitive tumors."
    },
    {
      "key": "text-f7c54bc5e2",
      "label": "Text",
      "section": "Pinpoint accuracy. Maximum precision.",
      "value": " RapidArc (IMRT)"
    },
    {
