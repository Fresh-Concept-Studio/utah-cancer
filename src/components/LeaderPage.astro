---
import { leaders } from '../lib/content';
import { url } from '../lib/urls';
import DetailSections from './DetailSections.astro';
interface Props { slug: string }
const leader = leaders.find(p => p.slug === Astro.props.slug);
if (!leader) throw new Error(`Unknown leader: ${Astro.props.slug}`);
const portrait = leader.photo.src.split('?')[0].replace(/\.(?:jpe?g|png|webp)$/i, '-600.webp');
---
<section class="provider-hero"><div class="container provider-hero-inner">
  <div class="provider-hero-text">
    <a href={url('/leadership.html')} class="provider-breadcrumb"><span class="material-symbols-rounded">arrow_back</span> All Leadership</a>
    <h1 class="provider-name">{leader.name}</h1><p class="provider-specialty">{leader.role}</p>
  </div>
  <div class={leader.photo.class}><img src={url(portrait)} width="600" height="750" alt={leader.photo.alt} fetchpriority="high" decoding="async" /></div>
</div></section>
<section class="provider-details"><div class="container provider-details-inner"><div class="provider-main"><DetailSections sections={leader.sections} /></div></div></section>
