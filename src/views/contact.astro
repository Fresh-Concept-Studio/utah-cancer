---
import { mainPhone } from '../data/contact';
import ContactForm from '../components/ContactForm.astro';
---
<section class="providers-hero">
    <div class="container">
      <h1 class="providers-hero-title">Contact Us</h1>
      <p class="providers-hero-desc">We’re here to help. Reach out to our team by phone, email, or the form below.</p>
    </div>
  </section>

  <section style="padding:80px 0;">
    <div class="container">
      <div class="contact-layout">
        <div>
          <h2 class="about-mission-title" style="margin-bottom:24px;">Send Us a Message</h2>
          <ContactForm />
        </div>
        <div>
          <h2 class="about-mission-title" style="margin-bottom:24px;">Get in Touch</h2>
          <div class="provider-credentials">
            <div class="credential"><div class="credential-icon"><span class="material-symbols-rounded">apartment</span></div><div class="credential-content"><h3 class="credential-label">Clinical Support Services</h3><p>10808 S. River Front Pkwy., Ste. 400<br>South Jordan, UT 84095</p></div></div>
            <div class="credential"><div class="credential-icon"><span class="material-symbols-rounded">phone</span></div><div class="credential-content"><h3 class="credential-label">Phone</h3><p><a href={mainPhone.href} style="color:#5e8b9e;">{mainPhone.display}</a><br>Monday–Friday, 9:00 AM – 5:00 PM</p></div></div>
            <div class="credential"><div class="credential-icon"><span class="material-symbols-rounded">mail</span></div><div class="credential-content"><h3 class="credential-label">Email</h3><p><a href="mailto:info@utcancer.com" style="color:#5e8b9e;">info@utcancer.com</a></p></div></div>
            <div class="credential"><div class="credential-icon"><span class="material-symbols-rounded">payments</span></div><div class="credential-content"><h3 class="credential-label">Billing Questions</h3><p><a href="tel:8012660878" style="color:#5e8b9e;">801.266.0878</a><br>Monday–Friday, 7:00 AM – 4:00 PM</p></div></div>
          </div>
          <div style="margin-top:32px; padding:24px; background:#f0f4f8; border-radius:16px; border:1px solid #e0e9ef;">
            <h3 style="font-family: var(--font-heading); font-size:17px; color:#00476b; margin-bottom:8px;">Need urgent medical attention?</h3>
            <p style="font-size:14px; color:#333333; opacity:0.8; line-height:22px;">If you need urgent care beyond regular office hours, please go directly to a hospital emergency room. A physician will be contacted upon your arrival. One of our physicians is always on call.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

<style>
  .contact-layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 80px; align-items: start; }
  @media (max-width: 760px) { .contact-layout { grid-template-columns: 1fr; gap: 48px; } }
</style>
