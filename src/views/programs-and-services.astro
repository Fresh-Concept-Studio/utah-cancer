---
import { url } from '../lib/urls';
---
<section class="providers-hero">
    <div class="container">
      <h1 class="providers-hero-title">Programs &amp; Services</h1>
      <p class="providers-hero-desc">Patient care that goes beyond medicine — addressing the physical, emotional, and practical challenges of cancer treatment.</p>
    </div>
  </section>

  <!-- Intro + pillars -->
  <section class="ps-intro">
    <div class="container">
      <div class="ps-intro-grid">
        <div>
          <span class="ps-eyebrow">Beyond medicine</span>
          <h2 class="ps-intro-title">Support that meets you where you are.</h2>
          <div class="ps-intro-image">
            <img src={url("/images/generated/programs-services-hero-960.webp")} width="960" height="640" alt="A warm community wellness room with chairs gathered for a quiet group session" fetchpriority="high" decoding="async">
          </div>
        </div>
        <div>
          <p class="ps-intro-body">Cancer treatment brings physical effects, but it also brings psychological and emotional ones — effects that can be difficult to manage on your own. Our programs and services support patients and caregivers through every part of that experience, and we encourage you to make stress reduction and community a part of your daily self-care.</p>
          <div class="ps-pillar-cards">
            <div class="ps-pillar-card">
              <div class="ps-pillar-icon"><span class="material-symbols-rounded">favorite</span></div>
              <div>
                <span class="ps-pillar-num">Pillar 01</span>
                <div class="ps-pillar-name">Emotional</div>
              </div>
            </div>
            <div class="ps-pillar-card">
              <div class="ps-pillar-icon"><span class="material-symbols-rounded">fitness_center</span></div>
              <div>
                <span class="ps-pillar-num">Pillar 02</span>
                <a href={url("/physical-therapy.html")} class="ps-pillar-name" style="text-decoration: underline; text-underline-offset: 4px;">Physical Therapy</a>
              </div>
            </div>
            <div class="ps-pillar-card">
              <div class="ps-pillar-icon"><span class="material-symbols-rounded">handshake</span></div>
              <div>
                <span class="ps-pillar-num">Pillar 03</span>
                <div class="ps-pillar-name">Practical</div>
              </div>
            </div>
            <div class="ps-pillar-card">
              <div class="ps-pillar-icon"><span class="material-symbols-rounded">school</span></div>
              <div>
                <span class="ps-pillar-num">Pillar 04</span>
                <div class="ps-pillar-name">Educational</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Recurring Programs -->
  <section class="ps-section ps-section--gray">
    <div class="container">
      <div class="ps-section-header">
        <span class="ps-eyebrow">Recurring sessions</span>
        <h2 class="ps-section-heading">Join us on a regular schedule.</h2>
        <p class="ps-section-sub">Two ongoing programs are open to any patient or caregiver — drop in when you need community or calm. Both are free and require no referral.</p>
      </div>

      <div class="ps-schedule-grid">
        <div class="ps-schedule-card">
          <div class="ps-schedule-badge">
            <span class="ps-schedule-badge-cadence">1st</span>
            <span class="ps-schedule-badge-day">WED</span>
            <span class="ps-schedule-badge-time">6–7pm</span>
          </div>
          <div class="ps-schedule-content">
            <span class="ps-schedule-tag">Monthly · Online or in person</span>
            <h3>Support Groups</h3>
            <p>The Jordan Valley Cancer Center Support Group is a welcoming space to find connection, perspective, and shared experience with others walking a similar path.</p>
            <div class="ps-schedule-meta">
              <div class="ps-schedule-meta-item"><span class="material-symbols-rounded">person</span><span>Facilitated by Dr. Gary Garner</span></div>
              <div class="ps-schedule-meta-item"><span class="material-symbols-rounded">location_on</span><span>3592 W. 9000 S., West Jordan</span></div>
            </div>
          </div>
        </div>

        <div class="ps-schedule-card">
          <div class="ps-schedule-badge ps-schedule-badge--alt">
            <span class="ps-schedule-badge-cadence">2nd</span>
            <span class="ps-schedule-badge-day">THU</span>
            <span class="ps-schedule-badge-time">7pm</span>
          </div>
          <div class="ps-schedule-content">
            <span class="ps-schedule-tag">Monthly · Virtual</span>
            <h3>SOMA Method Breathwork</h3>
            <p>Rhythmic and mindful breathing classes designed for cancer patients. A simple practice with measurable benefits for stress, sleep, and pain — no prior experience needed.</p>
            <div class="ps-schedule-meta">
              <div class="ps-schedule-meta-item"><span class="material-symbols-rounded">person</span><span>Led by Marie Asay</span></div>
              <div class="ps-schedule-meta-item"><span class="material-symbols-rounded">videocam</span><span>Online — link sent on registration</span></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Always-available services -->
  <section class="ps-section">
    <div class="container">
      <div class="ps-section-header">
        <span class="ps-eyebrow">Comprehensive support</span>
        <h2 class="ps-section-heading">Care services available throughout your journey.</h2>
        <p class="ps-section-sub">Built into your treatment from day one and adjusted as your needs change — ask your care team or patient advocate to connect you.</p>
      </div>

      <div class="ps-services-grid">
        <div class="ps-service" id="patient-advocacy" style="scroll-margin-top: 120px">
          <div class="ps-service-icon"><span class="material-symbols-rounded">volunteer_activism</span></div>
          <div>
            <h3>Patient Advocacy</h3>
            <p>Dedicated advocates coordinate insurance, financial assistance, and emotional support from your very first visit through the completion of treatment.</p>
          </div>
        </div>
        <div class="ps-service">
          <div class="ps-service-icon"><span class="material-symbols-rounded">restaurant</span></div>
          <div>
            <h3>Nutrition Guidance</h3>
            <p>Nutritional support and education to help optimize your health during treatment and aid in your recovery afterward.</p>
          </div>
        </div>
        <div class="ps-service">
          <div class="ps-service-icon"><span class="material-symbols-rounded">healing</span></div>
          <div>
            <h3>Supportive &amp; Palliative Care</h3>
            <p>Symptom management, pain control, and quality-of-life support throughout your treatment journey, led by our supportive care physician Dr. Gary Garner.</p>
          </div>
        </div>
        <div class="ps-service">
          <div class="ps-service-icon"><span class="material-symbols-rounded">school</span></div>
          <div>
            <h3>Educational Classes</h3>
            <p>Group instruction covering treatment expectations, managing side effects, caregiver support, and survivorship planning.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
