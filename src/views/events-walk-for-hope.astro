---
import { url } from '../lib/urls';
import EventShareLinks from '../components/EventShareLinks.astro';
---
<!-- Event Hero -->
  <section class="event-detail-hero">
    <div class="container event-detail-hero-inner">
      <div class="event-detail-hero-text">
        <a href={url("/events/index.html")} class="event-breadcrumb">
          <span class="material-symbols-rounded">arrow_back</span> All Events
        </a>
        <span class="event-category event-category--fundraiser">Fundraiser</span>
        <h1 class="event-detail-title">Walk for Hope 5K</h1>
        <p class="event-detail-tagline">Our annual community walk supporting cancer research, patient programs, and survivor celebrations — rain or shine.</p>
        <div class="event-detail-actions">
          <a href="#about" class="btn btn--outline-dark"><span class="material-symbols-rounded">arrow_downward</span> Learn More</a>
        </div>
      </div>
      <div class="event-ticket">
        <div class="event-ticket-top">
          <span class="event-ticket-month">JUN</span>
          <span class="event-ticket-day">15</span>
          <span class="event-ticket-year">2026</span>
        </div>
        <div class="event-ticket-perf"></div>
        <div class="event-ticket-bottom">
          <div class="event-ticket-row">
            <span class="event-ticket-label">Day</span>
            <span class="event-ticket-value">Saturday</span>
          </div>
          <div class="event-ticket-row">
            <span class="event-ticket-label">Start</span>
            <span class="event-ticket-value">8:00 AM</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Sticky Meta Bar -->
  <section class="event-meta-bar">
    <div class="container event-meta-bar-inner">
      <div class="event-meta-pill">
        <span class="material-symbols-rounded">calendar_today</span>
        <div>
          <span class="event-meta-label">Date</span>
          <span class="event-meta-value">Saturday, June 15, 2026</span>
        </div>
      </div>
      <div class="event-meta-pill">
        <span class="material-symbols-rounded">schedule</span>
        <div>
          <span class="event-meta-label">Time</span>
          <span class="event-meta-value">8:00 AM – 12:00 PM</span>
        </div>
      </div>
      <div class="event-meta-pill">
        <span class="material-symbols-rounded">location_on</span>
        <div>
          <span class="event-meta-label">Location</span>
          <span class="event-meta-value">Sugar House Park, SLC</span>
        </div>
      </div>
      <div class="event-meta-pill">
        <span class="material-symbols-rounded">payments</span>
        <div>
          <span class="event-meta-label">Registration</span>
          <span class="event-meta-value">$25 · Free for survivors</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Content -->
  <section class="event-detail-content">
    <div class="container event-detail-grid">
      <main class="event-detail-main">

        <div class="event-section" id="about">
          <h2 class="event-section-title">About this event</h2>
          <p class="event-section-lede">For nearly two decades, the Walk for Hope has been our largest community gathering of the year — a morning of movement, memory, and momentum.</p>
          <p>Patients, survivors, families, providers, and friends meet at the gates of Sugar House Park for a 5K route through one of Salt Lake's most beautiful green spaces. Every step funds patient assistance programs, lodging stipends for traveling patients, and clinical trial scholarships. Walk fast, walk slow, walk in honor of someone — or just come for the breakfast burritos and live music. There's a place for everyone.</p>
        </div>

        <div class="event-section">
          <h2 class="event-section-title">What to expect</h2>
          <ul class="event-list">
            <li><strong>Family-friendly 5K route</strong> through Sugar House Park — strollers, dogs on leashes, and walkers welcome.</li>
            <li><strong>Survivor recognition</strong> at the start line, with a short ceremony before the walk begins.</li>
            <li><strong>Breakfast &amp; coffee</strong> from local sponsors at the finish line.</li>
            <li><strong>Live acoustic music</strong> at the pavilion from 9:00 AM onward.</li>
            <li><strong>Kids' tent</strong> with face painting, crafts, and a photo booth.</li>
            <li><strong>Provider meet-and-greet</strong> at the UCS info booth from 10:00 AM – noon.</li>
          </ul>
        </div>

        <div class="event-section">
          <h2 class="event-section-title">Day-of schedule</h2>
          <div class="event-schedule">
            <div class="event-schedule-item">
              <div class="event-schedule-time">7:30 AM</div>
              <div class="event-schedule-body">
                <h3>Check-in opens</h3>
                <p>Pick up your bib, t-shirt, and goodie bag at the registration tent.</p>
              </div>
            </div>
            <div class="event-schedule-item">
              <div class="event-schedule-time">8:00 AM</div>
              <div class="event-schedule-body">
                <h3>Survivor walk &amp; opening ceremony</h3>
                <p>A short tribute and a survivor lap around the start area.</p>
              </div>
            </div>
            <div class="event-schedule-item">
              <div class="event-schedule-time">8:30 AM</div>
              <div class="event-schedule-body">
                <h3>5K starts</h3>
                <p>Walkers, runners, and rollers head out together.</p>
              </div>
            </div>
            <div class="event-schedule-item">
              <div class="event-schedule-time">9:30 AM</div>
              <div class="event-schedule-body">
                <h3>Breakfast, music &amp; community tent</h3>
                <p>Food, music, and time to connect with the UCS care teams.</p>
              </div>
            </div>
            <div class="event-schedule-item">
              <div class="event-schedule-time">11:30 AM</div>
              <div class="event-schedule-body">
                <h3>Closing remarks &amp; raffle</h3>
                <p>Prize draw and a thank-you from our patient ambassadors.</p>
              </div>
            </div>
          </div>
        </div>

        <div class="event-section">
          <h2 class="event-section-title">Frequently asked</h2>
          <details class="event-faq" open="">
            <summary>Do I need to register in advance?</summary>
            <p>Day-of registration is welcome, but pre-registration guarantees a t-shirt in your size and a smoother check-in. Online registration closes at midnight on June 13.</p>
          </details>
          <details class="event-faq">
            <summary>Is the route accessible?</summary>
            <p>Yes. The 5K route is paved the entire way, with gentle elevation changes. Wheelchairs, walkers, strollers, and assistive devices are all welcome. A 1-mile shorter route is also available for anyone who prefers.</p>
          </details>
          <details class="event-faq">
            <summary>What if it rains?</summary>
            <p>The walk happens rain or shine. Heavy lightning would shift the start time but not cancel the event — we'll communicate updates by email and on our social channels.</p>
          </details>
          <details class="event-faq">
            <summary>Can I walk in honor or in memory of someone?</summary>
            <p>Absolutely. The "I walk for..." badge is included in every check-in packet. Honoree names are also added to our community ribbon wall at the finish line.</p>
          </details>
          <details class="event-faq">
            <summary>Are dogs allowed?</summary>
            <p>Friendly, leashed dogs are welcome on the 5K route. Please bring waste bags and water for your pup.</p>
          </details>
        </div>

      </main>

      <aside class="event-detail-sidebar">
        <div class="sidebar-card">
          <h3 class="sidebar-card-title"><span class="material-symbols-rounded">info</span> Quick Facts</h3>
          <ul class="sidebar-facts">
            <li><span>Distance</span><strong>5K (3.1 mi) or 1-mile route</strong></li>
            <li><span>Surface</span><strong>Paved, accessible</strong></li>
            <li><span>Parking</span><strong>Free, Sugar House Park lot</strong></li>
            <li><span>Refreshments</span><strong>Provided</strong></li>
            <li><span>T-shirt</span><strong>Included with registration</strong></li>
          </ul>
        </div>

        <div class="sidebar-card">
          <h3 class="sidebar-card-title"><span class="material-symbols-rounded">map</span> Where</h3>
          <div class="sidebar-map-placeholder">
            <span class="material-symbols-rounded">location_on</span>
            <p>Sugar House Park<br>1330 E 2100 S<br>Salt Lake City, UT 84106</p>
          </div>
          <a href="https://maps.google.com/?q=Sugar+House+Park+Salt+Lake+City" target="_blank" rel="noopener" class="sidebar-card-link"><span class="material-symbols-rounded">directions</span> Get directions</a>
        </div>

        <div class="sidebar-card">
          <h3 class="sidebar-card-title"><span class="material-symbols-rounded">help</span> Questions?</h3>
          <p class="sidebar-card-desc">Email our events team or call us during clinic hours.</p>
          <p class="sidebar-contact-item"><strong>Email:</strong> <a href="mailto:events@utcancer.com">events@utcancer.com</a></p>
          <p class="sidebar-contact-item"><strong>Phone:</strong> <a href="tel:8012690231">801.269.0231</a></p>
        </div>

        <div class="sidebar-card">
          <h3 class="sidebar-card-title"><span class="material-symbols-rounded">share</span> Share</h3>
          <EventShareLinks title="Walk for Hope 5K" />
        </div>
      </aside>
    </div>
  </section>

  <!-- Related Events -->
  <section class="related-events">
    <div class="container">
      <div class="related-events-header">
        <span class="section-label">More to attend</span>
        <h2 class="related-events-title">Other events coming up</h2>
      </div>
      <div class="related-events-grid">
        <a href={url("/events/understanding-treatment-options.html")} class="event-card">
          <div class="event-card-date">
            <span class="event-card-month">MAY</span>
            <span class="event-card-day">12</span>
            <span class="event-card-year">2026</span>
          </div>
          <div class="event-card-body">
            <span class="event-category event-category--education">Patient Education</span>
            <h3 class="event-card-title">Understanding Your Treatment Options</h3>
            <p class="event-card-desc">A clear, supportive walkthrough of common treatment paths.</p>
          </div>
        </a>
        <a href={url("/events/survivorship-support-group.html")} class="event-card">
          <div class="event-card-date">
            <span class="event-card-month">MAY</span>
            <span class="event-card-day">28</span>
            <span class="event-card-year">2026</span>
          </div>
          <div class="event-card-body">
            <span class="event-category event-category--support">Support Group</span>
            <h3 class="event-card-title">Cancer Survivorship Support Group</h3>
            <p class="event-card-desc">A monthly gathering for survivors to share, connect, and find encouragement.</p>
          </div>
        </a>
        <a href={url("/events/patient-appreciation-dinner.html")} class="event-card">
          <div class="event-card-date">
            <span class="event-card-month">JUL</span>
            <span class="event-card-day">19</span>
            <span class="event-card-year">2026</span>
          </div>
          <div class="event-card-body">
            <span class="event-category event-category--community">Community</span>
            <h3 class="event-card-title">Annual Patient Appreciation Dinner</h3>
            <p class="event-card-desc">A celebration of the patients, families, and care teams that make UCS what it is.</p>
          </div>
        </a>
      </div>
    </div>
  </section>
