---
import { url } from '../lib/urls';
import { primaryLinks, menus, patientLinks } from '../data/navigation';
interface Props { activeNav?: string[] }
const { activeNav = [] } = Astro.props;
---
<header class="navbar">
  <div class="container navbar-inner">
    <a href={url('/index.html')} class="navbar-logo"><img src={url('/images/ucs-logo-white.svg')} alt="Utah Cancer Specialists" /></a>
    <button class="navbar-hamburger" id="navbar-hamburger" aria-label="Toggle menu" aria-expanded="false"><span></span><span></span><span></span></button>
    <nav class="navbar-nav">
      {primaryLinks.map(link => <a href={url(link.href)} class:list={['nav-link', {active: activeNav.includes(link.label)}]}>{link.label}</a>)}
      {menus.map((menu, index) => <div class:list={['nav-dropdown', { 'nav-dropdown--linked': !!menu.href }]}>
        {menu.href ? <>
          <a href={url(menu.href)} class="nav-link nav-dropdown-toggle">{menu.label} <span class="material-symbols-rounded nav-dropdown-arrow" aria-hidden="true">expand_more</span></a>
          <button type="button" class="nav-dropdown-disclosure" aria-label={`Toggle ${menu.label} submenu`} aria-expanded="false" aria-controls={`nav-submenu-${index}`}><span class="material-symbols-rounded nav-dropdown-arrow" aria-hidden="true">expand_more</span></button>
        </> : <button class="nav-link nav-dropdown-toggle">{menu.label} <span class="material-symbols-rounded nav-dropdown-arrow">expand_more</span></button>}
        <div id={`nav-submenu-${index}`} class="nav-dropdown-menu"><div class="nav-dropdown-menu-inner">
          {menu.links.map(link => link.comingSoon ?
            <button type="button" class="nav-dropdown-item nav-dropdown-item--button" data-coming-soon aria-haspopup="dialog" aria-controls="coming-soon-modal">{link.label}</button> :
            <a href={url(link.href)} class="nav-dropdown-item">{link.label}</a>
          )}
        </div></div>
      </div>)}
      {patientLinks.map(link => <a href={link.href} target="_blank" rel="noopener" class="nav-link nav-link--icon"><span class="material-symbols-rounded">{link.icon}</span> {link.label}</a>)}
      <button type="button" class="nav-btn-cta" data-coming-soon aria-haspopup="dialog" aria-controls="coming-soon-modal"><span class="material-symbols-rounded" aria-hidden="true">volunteer_activism</span> Donate Now</button>
    </nav>
  </div>
</header>
<div class="mobile-menu-overlay" id="mobile-menu-overlay"></div>

<style>
  .nav-dropdown-disclosure { display: none; }
  .nav-dropdown-item--button { width: 100%; border: 0; background: none; font-family: var(--font-body); text-align: left; cursor: pointer; }
  @media (max-width: 1024px) {
    .nav-dropdown--linked { display: grid; grid-template-columns: 1fr 44px; width: 100%; }
    .nav-dropdown--linked > a .nav-dropdown-arrow { display: none; }
    .nav-dropdown-disclosure { display: grid; place-items: center; min-height: 44px; border: 0; border-bottom: 1px solid rgb(255 255 255 / 8%); background: none; color: #fff; cursor: pointer; }
    .nav-dropdown-disclosure:focus-visible { outline: 2px solid #fff; outline-offset: -4px; }
    .nav-dropdown-disclosure .nav-dropdown-arrow { transform: none; }
    .nav-dropdown-disclosure[aria-expanded="true"] .nav-dropdown-arrow { transform: rotate(180deg); }
    .nav-dropdown--linked .nav-dropdown-menu { display: none; grid-column: 1 / -1; position: static; padding: 0 0 12px; visibility: visible; opacity: 1; transform: none; }
    .nav-dropdown--linked[data-expanded] .nav-dropdown-menu { display: block; }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.nav-dropdown-disclosure').forEach(button => {
    button.addEventListener('click', () => {
      const expanded = button.getAttribute('aria-expanded') !== 'true';
      button.setAttribute('aria-expanded', String(expanded));
      button.closest('.nav-dropdown')?.toggleAttribute('data-expanded', expanded);
    });
  });
</script>
