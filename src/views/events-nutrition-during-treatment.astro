---
import { url } from '../lib/urls';
---
<!-- Event Hero -->
  <section class="event-detail-hero">
    <div class="container event-detail-hero-inner">
      <div class="event-detail-hero-text">
        <a href={url("/events/index.html")} class="event-breadcrumb">
          <span class="material-symbols-rounded">arrow_back</span> All Events
        </a>
        <span class="event-category event-category--education">Patient Education</span>
        <h1 class="event-detail-title">Nutrition During Treatment</h1>
        <p class="event-detail-tagline">Working with our oncology dietitians to fuel your body through chemo, radiation, and recovery.</p>
        <div class="event-detail-actions">
          <a href="#" class="btn btn--primary"><span class="material-symbols-rounded">how_to_reg</span> Register</a>
          <a href="#about" class="btn btn--outline-dark"><span class="material-symbols-rounded">arrow_downward</span> Learn More</a>
        </div>
      </div>
      <div class="event-ticket">
        <div class="event-ticket-top">
          <span class="event-ticket-month">JUL</span>
          <span class="event-ticket-day">28</span>
          <span class="event-ticket-year">2026</span>
        </div>
        <div class="event-ticket-perf"></div>
        <div class="event-ticket-bottom">
          <div class="event-ticket-row">
            <span class="event-ticket-label">Day</span>
            <span class="event-ticket-value">Tuesday</span>
          </div>
          <div class="event-ticket-row">
            <span class="event-ticket-label">Start</span>
            <span class="event-ticket-value">1:00 PM</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Sticky Meta Bar -->
  <section class="event-meta-bar">
    <div class="container event-meta-bar-inner">
      <div class="event-meta-pill">
        <span class="material-symbols-rounded">calendar_today</span>
        <div>
          <span class="event-meta-label">Date</span>
          <span class="event-meta-value">Tuesday, July 28, 2026</span>
        </div>
      </div>
      <div class="event-meta-pill">
        <span class="material-symbols-rounded">schedule</span>
        <div>
          <span class="event-meta-label">Time</span>
          <span class="event-meta-value">1:00 PM – 2:30 PM</span>
        </div>
      </div>
      <div class="event-meta-pill">
        <span class="material-symbols-rounded">location_on</span>
        <div>
          <span class="event-meta-label">Location</span>
          <span class="event-meta-value">Virtual (Zoom)</span>
        </div>
      </div>
      <div class="event-meta-pill">
        <span class="material-symbols-rounded">payments</span>
        <div>
          <span class="event-meta-label">Registration</span>
          <span class="event-meta-value">Free · Registration required</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Content -->
  <section class="event-detail-content">
    <div class="container event-detail-grid">
      <main class="event-detail-main">

        <div class="event-section" id="about">
          <h2 class="event-section-title">About this event</h2>
          <p class="event-section-lede">Treatment changes how your body responds to food. Cravings shift, taste fades, energy crashes. The good news: small adjustments make a real difference.</p>
          <p>Led by our oncology dietitian team, this 90-minute session covers practical nutrition strategies for patients in active treatment. We'll talk about managing nausea, getting protein in when nothing tastes good, hydration on chemo days, and how to think about supplements. We'll send a recipe pack and a printable shopping list to every registrant.</p>
        </div>

        <div class="event-section">
          <h2 class="event-section-title">What to expect</h2>
          <ul class="event-list">
            <li><strong>Eating through nausea</strong> what works when nothing sounds good.</li>
            <li><strong>Protein on hard days</strong> shake recipes, easy proteins, and why it matters.</li>
            <li><strong>Hydration strategies</strong> what to drink and when, especially around infusions.</li>
            <li><strong>Supplements 101</strong> what's helpful, what's hype, what to avoid.</li>
            <li><strong>Recipe pack</strong> 10 oncologist-approved recipes emailed to every attendee.</li>
          </ul>
        </div>

        <div class="event-section">
          <h2 class="event-section-title">Day-of schedule</h2>
          <div class="event-schedule">
            <div class="event-schedule-item">
              <div class="event-schedule-time">1:00 PM</div>
              <div class="event-schedule-body">
                <h3>Welcome &amp; intros</h3>
                <p>Quick overview of the session.</p>
              </div>
            </div>
            <div class="event-schedule-item">
              <div class="event-schedule-time">1:10 PM</div>
              <div class="event-schedule-body">
                <h3>Eating through treatment</h3>
                <p>Nausea, taste changes, energy.</p>
              </div>
            </div>
            <div class="event-schedule-item">
              <div class="event-schedule-time">1:35 PM</div>
              <div class="event-schedule-body">
                <h3>Hydration &amp; protein</h3>
                <p>Practical tactics for hard days.</p>
              </div>
            </div>
            <div class="event-schedule-item">
              <div class="event-schedule-time">2:00 PM</div>
              <div class="event-schedule-body">
                <h3>Supplements &amp; safety</h3>
                <p>What to ask before adding anything.</p>
              </div>
            </div>
            <div class="event-schedule-item">
              <div class="event-schedule-time">2:15 PM</div>
              <div class="event-schedule-body">
                <h3>Live Q&amp;A</h3>
                <p>Bring your specific questions.</p>
              </div>
            </div>
          </div>
        </div>

        <div class="event-section">
          <h2 class="event-section-title">Frequently asked</h2>
          <details class="event-faq">
            <summary>Will this be specific to my type of cancer?</summary>
            <p>Many strategies are universal. For diagnosis-specific questions, our dietitian team offers individual consults — we'll share how to book one.</p>
          </details>
          <details class="event-faq">
            <summary>Will it be recorded?</summary>
            <p>Yes. Registered attendees receive a link within 48 hours.</p>
          </details>
          <details class="event-faq">
            <summary>Can my caregiver attend with me?</summary>
            <p>Absolutely — caregivers often find these sessions just as useful.</p>
          </details>
          <details class="event-faq">
            <summary>Do I need a Zoom account?</summary>
            <p>No, just the link we send you. It works in a browser.</p>
          </details>
        </div>

      </main>

      <aside class="event-detail-sidebar">
        <div class="sidebar-card sidebar-card--cta">
          <h3 class="sidebar-card-title">Register</h3>
          <p class="sidebar-card-desc">Free, registration required.</p>
          <a href="#" class="btn btn--primary btn--full"><span class="material-symbols-rounded">how_to_reg</span> Register Now</a>
          <a href="#" class="sidebar-card-link">Add to calendar</a>
        </div>

        <div class="sidebar-card">
          <h3 class="sidebar-card-title"><span class="material-symbols-rounded">info</span> Quick Facts</h3>
          <ul class="sidebar-facts">
            <li><span>Format</span><strong>Live virtual session</strong></li>
            <li><span>Length</span><strong>90 minutes</strong></li>
            <li><span>Cost</span><strong>Free</strong></li>
            <li><span>Materials</span><strong>Recipe pack &amp; shopping list</strong></li>
            <li><span>Recording</span><strong>Sent to all registrants</strong></li>
          </ul>
        </div>

        <div class="sidebar-card">
          <h3 class="sidebar-card-title"><span class="material-symbols-rounded">map</span> Where</h3>
          <div class="sidebar-map-placeholder">
            <span class="material-symbols-rounded">location_on</span>
            <p>Online via Zoom<br>A Zoom link will be sent<br>to the email you register with.</p>
          </div>
          <a href="#" target="_blank" rel="noopener" class="sidebar-card-link"><span class="material-symbols-rounded">directions</span> How Zoom works</a>
        </div>

        <div class="sidebar-card">
          <h3 class="sidebar-card-title"><span class="material-symbols-rounded">help</span> Questions?</h3>
          <p class="sidebar-card-desc">Email our events team or call us during clinic hours.</p>
          <p class="sidebar-contact-item"><strong>Email:</strong> <a href="mailto:events@utcancer.com">events@utcancer.com</a></p>
          <p class="sidebar-contact-item"><strong>Phone:</strong> <a href="tel:8012690231">801.269.0231</a></p>
        </div>

        <div class="sidebar-card">
          <h3 class="sidebar-card-title"><span class="material-symbols-rounded">share</span> Share</h3>
          <div class="event-share">
            <a href="#" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
            <a href="#" aria-label="X"><i class="fab fa-twitter"></i></a>
            <a href="#" aria-label="LinkedIn"><i class="fab fa-linkedin-in"></i></a>
            <a href="#" aria-label="Email"><span class="material-symbols-rounded">mail</span></a>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <!-- Related Events -->
  <section class="related-events">
    <div class="container">
      <div class="related-events-header">
        <span class="section-label">More to attend</span>
        <h2 class="related-events-title">Other events coming up</h2>
      </div>
      <div class="related-events-grid">
        <a href={url("/events/walk-for-hope.html")} class="event-card">
          <div class="event-card-date">
            <span class="event-card-month">JUN</span>
            <span class="event-card-day">15</span>
            <span class="event-card-year">2026</span>
          </div>
          <div class="event-card-body">
            <span class="event-category event-category--fundraiser">Fundraiser</span>
            <h3 class="event-card-title">Walk for Hope 5K</h3>
            <p class="event-card-desc">Annual community walk supporting research and patient programs.</p>
          </div>
        </a>
        <a href={url("/events/understanding-treatment-options.html")} class="event-card">
          <div class="event-card-date">
            <span class="event-card-month">MAY</span>
            <span class="event-card-day">12</span>
            <span class="event-card-year">2026</span>
          </div>
          <div class="event-card-body">
            <span class="event-category event-category--education">Patient Education</span>
            <h3 class="event-card-title">Understanding Your Treatment Options</h3>
            <p class="event-card-desc">A clear walkthrough of common treatment paths.</p>
          </div>
        </a>
        <a href={url("/events/survivorship-support-group.html")} class="event-card">
          <div class="event-card-date">
            <span class="event-card-month">MAY</span>
            <span class="event-card-day">28</span>
            <span class="event-card-year">2026</span>
          </div>
          <div class="event-card-body">
            <span class="event-category event-category--support">Support Group</span>
            <h3 class="event-card-title">Cancer Survivorship Support Group</h3>
            <p class="event-card-desc">Monthly gathering for survivors to connect and share.</p>
          </div>
        </a>
      </div>
    </div>
  </section>
