---
import { pageEditor } from '../lib/page-content';
const edit = pageEditor(Astro.props.page);
import { url } from '../lib/urls';
import MediaHighlights from '../components/MediaHighlights.astro';
---
<!-- Hero Section -->
  <section class="hero">
    <div class="hero-bg">
      <img
        src={url(edit.image("image-01b7dc653d", "/images/hero-bg.webp"))}
        srcset={edit.imageChanged("image-01b7dc653d", "/images/hero-bg.webp") ? undefined : `${url("/images/hero-bg-720.webp")} 720w, ${url("/images/hero-bg.webp")} 1536w`}
        sizes="100vw"
        width="1536"
        height="1024"
        alt={edit.imageAlt("image-01b7dc653d", "")}
        fetchpriority="high"
        decoding="async"
      >
      <div class="hero-overlay"></div>
    </div>
    <div class="container hero-content">
      <h1 class="hero-heading">{edit.text("text-d50c89d5bd", "Expertise You Can Trust. Care You Can Feel.")}</h1>
    </div>
  </section>

  <!-- Hero action cards (sits at the bottom of the hero, behind the team section) -->
  <div class="hero-cards">
    <div class="container">
      <div class="hero-cards-panel">
        <a href={url(edit.text("link-fc55c827ec", "/providers/index.html"))} class="hero-card">
          <span class="hero-card-icon material-symbols-rounded">groups</span>
          <span class="hero-card-content">
            <span class="hero-card-eyebrow">{edit.text("text-42a9a87497", "Meet the team")}</span>
            <span class="hero-card-title">{edit.text("text-85be06b797", "Our Providers")}</span>
          </span>
          <span class="hero-card-arrow material-symbols-rounded">arrow_outward</span>
        </a>
        <a href={url(edit.text("link-b047de7b39", "/locations/index.html"))} class="hero-card">
          <span class="hero-card-icon material-symbols-rounded">location_on</span>
          <span class="hero-card-content">
            <span class="hero-card-eyebrow">{edit.text("text-fdab89baf0", "13 Utah locations")}</span>
            <span class="hero-card-title">{edit.text("text-b354f9d8e0", "Find a Location")}</span>
          </span>
          <span class="hero-card-arrow material-symbols-rounded">arrow_outward</span>
        </a>
        <a href={url(edit.text("link-f5e6f072f6", "/specialties/index.html"))} class="hero-card">
          <span class="hero-card-icon material-symbols-rounded">stethoscope</span>
          <span class="hero-card-content">
            <span class="hero-card-eyebrow">{edit.text("text-fb3e70ecf4", "What we treat")}</span>
            <span class="hero-card-title">{edit.text("text-9a5f9d6772", "Types of Cancer")}</span>
          </span>
          <span class="hero-card-arrow material-symbols-rounded">arrow_outward</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Team Section -->
  <section class="team-section">
    <div class="container team-inner">
      <div class="team-text">
        <h2 class="team-heading">{edit.text("text-303d25c6fa", "Here With You.")}</h2>
        <p class="team-description">{edit.text("text-a363e854aa", "Utah Cancer Specialists provides advanced, evidence-based cancer care in a supportive setting focused on your total well-being—physical, emotional, and financial. Our board-certified physicians and care teams are here with you, guiding you with expertise and compassion.")}</p>
        <a href={url(edit.text("link-fc55c827ec-1", "/providers/index.html"))} class="btn btn--primary team-cta">
          <span class="material-symbols-rounded">person</span>{edit.text("text-eea28e7278", " Meet our Providers ")}</a>
      </div>
      <div class="team-photos">
        <div class="team-photo team-photo--single">
          <img
            src={url(edit.image("image-0c89bb1083", "/images/team-ucs-group-960.webp"))}
            srcset={edit.imageChanged("image-0c89bb1083", "/images/team-ucs-group-960.webp") ? undefined : `${url("/images/team-ucs-group-480.webp")} 480w, ${url("/images/team-ucs-group-960.webp")} 960w`}
            sizes="(max-width: 700px) 100vw, 540px"
            width="960"
            height="640"
            alt={edit.imageAlt("image-0c89bb1083", "The Utah Cancer Specialists care team")}
            loading="lazy"
            decoding="async"
          >
        </div>
      </div>
    </div>
  </section>

  <!-- Specialties Section -->
  <section class="specialties-section">
    <div class="container">
      <div class="specialties-header">
        <div class="specialties-header-left">
          <h2 class="specialties-heading">{edit.text("text-7a772597f4", "Our Services")}</h2>
          <p class="specialties-desc">{edit.text("text-e0e9a7cda3", "Our cancer specialists provide advanced treatments tailored to your specific cancer type and stage.")}</p>
        </div>
        <div class="specialties-header-right">
          <a href={url(edit.text("link-f5e6f072f6-1", "/specialties/index.html"))} class="btn btn--outline">{edit.text("text-639f2d4a4d", "See All Types of Cancer")}</a>
          <div class="carousel-controls">
            <button class="carousel-btn carousel-btn--prev" aria-label="Previous"><span class="material-symbols-rounded" aria-hidden="true">arrow_back</span></button>
            <button class="carousel-btn carousel-btn--next" aria-label="Next"><span class="material-symbols-rounded" aria-hidden="true">arrow_forward</span></button>
          </div>
        </div>
      </div>
      <div class="specialties-carousel">
        <div class="carousel-track">
          <a href={url(edit.text("link-dfc978b2d8", "/specialties/breast-cancer.html"))} class="specialty-card">
            <img src={url(edit.image("image-72044990ed", "/images/specialty-breast-clinical-card-480.webp"))} width="480" height="640" alt={edit.imageAlt("image-72044990ed", "Breast Cancer Treatment")} class="specialty-card-img" loading="lazy" decoding="async">
            <div class="specialty-card-overlay"></div>
            <div class="specialty-card-content">
              <h3 class="specialty-card-title">{edit.text("text-95cab7b008", "Breast Cancer Treatment")}</h3>
            </div>
            <span class="specialty-card-arrow material-symbols-rounded" aria-hidden="true">arrow_forward</span>
          </a>
          <a href={url(edit.text("link-c5a1b937c3", "/specialties/prostate-cancer.html"))} class="specialty-card">
            <img src={url(edit.image("image-ad25028388", "/images/specialty-prostate-clinical-card-480.webp"))} width="480" height="640" alt={edit.imageAlt("image-ad25028388", "Prostate Cancer Care")} class="specialty-card-img" loading="lazy" decoding="async">
            <div class="specialty-card-overlay"></div>
            <div class="specialty-card-content">
              <h3 class="specialty-card-title">{edit.text("text-d0ef0de5ad", "Prostate Cancer Care")}</h3>
            </div>
            <span class="specialty-card-arrow material-symbols-rounded" aria-hidden="true">arrow_forward</span>
          </a>
          <a href={url(edit.text("link-223f73eed2", "/specialties/lung-cancer.html"))} class="specialty-card">
            <img src={url(edit.image("image-4b32e2e5ff", "/images/specialty-lung-clinical-card-480.webp"))} width="480" height="640" alt={edit.imageAlt("image-4b32e2e5ff", "Lung Cancer Treatment")} class="specialty-card-img" loading="lazy" decoding="async">
            <div class="specialty-card-overlay"></div>
            <div class="specialty-card-content">
              <h3 class="specialty-card-title">{edit.text("text-28cb9561f0", "Lung Cancer Treatment")}</h3>
            </div>
            <span class="specialty-card-arrow material-symbols-rounded" aria-hidden="true">arrow_forward</span>
          </a>
          <a href={url(edit.text("link-2696a50694", "/specialties/colon-cancer.html"))} class="specialty-card">
            <img src={url(edit.image("image-beb4c69bff", "/images/specialty-colon-clinical-card-480.webp"))} width="480" height="640" alt={edit.imageAlt("image-beb4c69bff", "Colon Cancer Treatment")} class="specialty-card-img" loading="lazy" decoding="async">
            <div class="specialty-card-overlay"></div>
            <div class="specialty-card-content">
              <h3 class="specialty-card-title">{edit.text("text-208b5a2073", "Colon Cancer Treatment")}</h3>
            </div>
            <span class="specialty-card-arrow material-symbols-rounded" aria-hidden="true">arrow_forward</span>
          </a>
          <a href={url(edit.text("link-75b3adbcab", "/specialties/lymphomas.html"))} class="specialty-card">
            <img src={url(edit.image("image-0268bc4afe", "/images/specialty-lymphoma-clinical-card-480.webp"))} width="480" height="640" alt={edit.imageAlt("image-0268bc4afe", "Lymphomas")} class="specialty-card-img" loading="lazy" decoding="async">
            <div class="specialty-card-overlay"></div>
            <div class="specialty-card-content">
              <h3 class="specialty-card-title">{edit.text("text-03e5129b8d", "Lymphomas")}</h3>
            </div>
            <span class="specialty-card-arrow material-symbols-rounded" aria-hidden="true">arrow_forward</span>
          </a>
          <a href={url(edit.text("link-8fcd9bcbb5", "/specialties/blood-cancers.html"))} class="specialty-card">
            <img src={url(edit.image("image-f54b9c3fbb", "/images/specialty-blood-clinical-card-480.webp"))} width="480" height="640" alt={edit.imageAlt("image-f54b9c3fbb", "Blood Cancers")} class="specialty-card-img" loading="lazy" decoding="async">
            <div class="specialty-card-overlay"></div>
            <div class="specialty-card-content">
              <h3 class="specialty-card-title">{edit.text("text-d5b3c0ffc4", "Blood Cancers")}</h3>
            </div>
            <span class="specialty-card-arrow material-symbols-rounded" aria-hidden="true">arrow_forward</span>
          </a>
          <a href={url(edit.text("link-cc2fd2b3cc", "/specialties/head-neck-cancers.html"))} class="specialty-card">
            <img src={url(edit.image("image-ef47ce2ded", "/images/specialty-headneck-clinical-card-480.webp"))} width="480" height="640" alt={edit.imageAlt("image-ef47ce2ded", "Head and Neck Cancers")} class="specialty-card-img" loading="lazy" decoding="async">
            <div class="specialty-card-overlay"></div>
            <div class="specialty-card-content">
              <h3 class="specialty-card-title">{edit.text("text-bab99559af", "Head & Neck Cancers")}</h3>
            </div>
            <span class="specialty-card-arrow material-symbols-rounded" aria-hidden="true">arrow_forward</span>
          </a>
          <a href={url(edit.text("link-071951abfe", "/specialties/kidney-cancer.html"))} class="specialty-card">
            <img src={url(edit.image("image-ce90afdf7f", "/images/specialty-kidney-clinical-card-480.webp"))} width="480" height="640" alt={edit.imageAlt("image-ce90afdf7f", "Kidney Cancer")} class="specialty-card-img" loading="lazy" decoding="async">
            <div class="specialty-card-overlay"></div>
            <div class="specialty-card-content">
              <h3 class="specialty-card-title">{edit.text("text-eab425d6ba", "Kidney Cancer")}</h3>
            </div>
            <span class="specialty-card-arrow material-symbols-rounded" aria-hidden="true">arrow_forward</span>
          </a>
          <a href={url(edit.text("link-fef6c1b8e7", "/specialties/liver-cancer.html"))} class="specialty-card">
            <img src={url(edit.image("image-d40c3a9293", "/images/specialty-liver-clinical-card-480.webp"))} width="480" height="640" alt={edit.imageAlt("image-d40c3a9293", "Liver Cancer")} class="specialty-card-img" loading="lazy" decoding="async">
            <div class="specialty-card-overlay"></div>
            <div class="specialty-card-content">
              <h3 class="specialty-card-title">{edit.text("text-f3274d1c2d", "Liver Cancer")}</h3>
            </div>
            <span class="specialty-card-arrow material-symbols-rounded" aria-hidden="true">arrow_forward</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Events Section -->
  <section class="home-events">
    <div class="container">
      <div class="home-events-header">
        <div>
          <span class="section-label">{edit.text("text-c5497bca58", "Events")}</span>
          <h2 class="home-events-heading">{edit.text("text-69a1d878f6", "Happening Soon")}</h2>
        </div>
        <a href={url(edit.text("link-3a81e87470", "/events/index.html"))} class="btn btn--primary btn--compact">
          <span class="material-symbols-rounded">calendar_month</span>{edit.text("text-7391cb9a4e", " See All Events ")}</a>
      </div>
      <div class="home-events-grid">
        <a href={url(edit.text("link-9102f2cae1", "/events/index.html#pink-bag-event"))} class="event-feature">
          <span class="event-feature-media">
            <img src={url(edit.image("image-8ad26086fb", "/images/event-pink-bag-640.webp"))} width="640" height="320" alt={edit.imageAlt("image-8ad26086fb", "People receiving pink resource bags at a community event")} class="event-feature-img" loading="lazy" decoding="async">
            <span class="event-feature-chip">{edit.text("text-7fc8527c20", "Featured · Patient Resources")}</span>
          </span>
          <span class="event-feature-body">
            <span class="event-feature-when">{edit.text("text-4aff87fb31", "Saturday, September 26")}</span>
            <span class="event-feature-title">{edit.text("text-108325cf43", "Pink Bag Event")}</span>
            <span class="event-feature-desc">{edit.text("text-11f8f8c6ad", "A community resource and support event for breast cancer patients and survivors.")}</span>
            <span class="event-feature-meta"><span class="material-symbols-rounded">schedule</span>{edit.text("text-9c9b7075b2", " Time and location details forthcoming")}</span>
            <span class="event-feature-cta">{edit.text("text-d3905ac921", "Event details ")}<span class="material-symbols-rounded">arrow_forward</span></span>
          </span>
        </a>
        <div class="event-mini-list">
          <a href={url(edit.text("link-746a0d23a3", "https://utahprostatecancerrun.com/"))} class="event-mini" target="_blank" rel="noopener">
            <span class="event-mini-thumb"><img src={url(edit.image("image-27c1d97053", "/images/event-prostate-run-240.webp"))} width="240" height="127" alt={edit.imageAlt("image-27c1d97053", "")} loading="lazy" decoding="async"></span>
            <span class="event-mini-info">
              <span class="event-mini-title">{edit.text("text-3d7e931962", "Utah Prostate Cancer Run & Walk")}</span>
              <span class="event-mini-meta">{edit.text("text-0491ada185", "Oct 10 · Wheeler Historic Farm")}</span>
            </span>
            <span class="material-symbols-rounded event-mini-arrow">arrow_forward</span>
          </a>
          <a href={url(edit.text("link-4e3c6d529a", "https://runtasticevents.com/races/haunted-salt-lake-city/"))} class="event-mini" target="_blank" rel="noopener">
            <span class="event-mini-thumb"><img src={url(edit.image("image-b181c0da68", "/images/event-haunted-half-240.webp"))} width="240" height="120" alt={edit.imageAlt("image-b181c0da68", "")} loading="lazy" decoding="async"></span>
            <span class="event-mini-info">
              <span class="event-mini-title">{edit.text("text-df0b58f960", "HAUNTED Salt Lake City")}</span>
              <span class="event-mini-meta">{edit.text("text-00989d61f3", "Oct 17 · Half starts 8:00 AM · Sugar House Park")}</span>
            </span>
            <span class="material-symbols-rounded event-mini-arrow">arrow_forward</span>
          </a>
          <a href={url(edit.text("link-551fa613f6", "/events/index.html#making-strides"))} class="event-mini">
            <span class="event-mini-thumb"><img src={url(edit.image("image-60f03e5a67", "/images/event-making-strides-240.webp"))} width="240" height="150" alt={edit.imageAlt("image-60f03e5a67", "")} loading="lazy" decoding="async"></span>
            <span class="event-mini-info">
              <span class="event-mini-title">{edit.text("text-deac30791e", "Making Strides Against Breast Cancer Walk")}</span>
              <span class="event-mini-meta">{edit.text("text-7353e90836", "Oct 24 · America First Field")}</span>
            </span>
            <span class="material-symbols-rounded event-mini-arrow">arrow_forward</span>
          </a>
        </div>
      </div>

      <!-- Podcast Launch Section -->
      <section class="podcast-section" aria-label="The UCS Podcast">
        <div class="podcast-inner">
          <div class="podcast-content">
            <span class="podcast-eyebrow"><span class="material-symbols-rounded">podcasts</span>{edit.text("text-18334276bd", " The UCS Podcast")}</span>
            <h2 class="podcast-heading">{edit.text("text-303d25c6fa-1", "Here With You.")}<br>{edit.text("text-d0955a0db3", "Where good conversations live.")}</h2>
            <p class="podcast-desc">{edit.text("text-4abcc77ab1", "Hosted by Scott Jeffrey Miller, the ")}<em>{edit.text("text-07cf876731", "Here With You")}</em>{edit.text("text-b8683881a4", " podcast brings honest conversations with physicians, patients, care teams, advocates, and voices from across our community—about cancer, care, and everything in between.")}</p>
            <ul class="podcast-episodes">
              <li class="podcast-episode">
                <span class="material-symbols-rounded podcast-episode-play">play_circle</span>
                <span class="podcast-episode-info">
                  <span class="podcast-episode-title">{edit.text("text-0f112f2abc", "What I wish every newly diagnosed patient knew")}</span>
                  <span class="podcast-episode-meta">{edit.text("text-ad224d60c7", "Episode 1")}</span>
                </span>
              </li>
              <li class="podcast-episode">
                <span class="material-symbols-rounded podcast-episode-play">play_circle</span>
                <span class="podcast-episode-info">
                  <span class="podcast-episode-title">{edit.text("text-348bf59f04", "Clinical trials, demystified")}</span>
                  <span class="podcast-episode-meta">{edit.text("text-508123b9a8", "Episode 2")}</span>
                </span>
              </li>
              <li class="podcast-episode">
                <span class="material-symbols-rounded podcast-episode-play">play_circle</span>
                <span class="podcast-episode-info">
                  <span class="podcast-episode-title">{edit.text("text-286bbd2757", "Caring for the caregiver")}</span>
                  <span class="podcast-episode-meta">{edit.text("text-c58f2fd857", "Episode 3")}</span>
                </span>
              </li>
            </ul>
            <div class="podcast-actions">
              <a href={url(edit.text("link-3bc9360b95", "https://www.facebook.com/utahcancerspecialists"))} target="_blank" rel="noopener" class="btn btn--white">
                <span class="material-symbols-rounded">notifications</span>{edit.text("text-7a76cb170a", " Notify Me at Launch ")}</a>
              <a href={url(edit.text("link-3bc9360b95-1", "https://www.facebook.com/utahcancerspecialists"))} target="_blank" rel="noopener" class="podcast-announce-link">{edit.text("text-aa714f78d2", " See the announcement ")}<span class="material-symbols-rounded">arrow_outward</span>
              </a>
            </div>
          </div>
          <div class="podcast-art">
            <div class="podcast-cover">
              <img src={url(edit.image("image-ae5ea1660b", "/images/ucs-logo-white.svg"))} width="589" height="192" alt={edit.imageAlt("image-ae5ea1660b", "Utah Cancer Specialists")} class="podcast-cover-logo" loading="lazy" decoding="async">
              <img src={url(edit.image("image-40d1c4dafc", "/images/scott-jeffrey-miller.webp"))} width="1590" height="1600" alt={edit.imageAlt("image-40d1c4dafc", "Scott Jeffrey Miller, host of the Here With You podcast")} class="podcast-cover-portrait" loading="lazy" decoding="async">
              <span class="podcast-cover-title">{edit.text("text-ecbcb0e424", "Here")}<br>{edit.text("text-564f8c6e76", "With")}<br>{edit.text("text-905cb326c7", "You")}</span>
              <span class="podcast-cover-badge">{edit.text("text-bafb6ef296", "Podcast")}</span>
              <span class="podcast-cover-host">{edit.text("text-cf51317501", "Hosted by Scott Jeffrey Miller")}</span>
              <div class="podcast-wave" aria-hidden="true">
                <span></span><span></span><span></span><span></span><span></span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- News and media highlights -->
      <MediaHighlights page={Astro.props.page} />
    </div>
  </section>

  <!-- Patient Stories Section -->
  <section class="stories-section">
    <div class="container">
      <div class="stories-header">
        <div>
          <span class="section-label">{edit.text("text-19e93c72e0", "Patient Stories")}</span>
          <h2 class="stories-heading">{edit.text("text-85a09fbd84", "Every journey deserves to be told.")}</h2>
        </div>
        <div class="stories-nav">
          <a href={url(edit.text("link-b4ae4f4939", "/stories/index.html"))} class="stories-all">{edit.text("text-92d13e9758", "View all stories")}</a>
          <div class="carousel-controls">
            <button class="carousel-btn carousel-btn--prev" id="story-prev" aria-label="Previous story"><span class="material-symbols-rounded" aria-hidden="true">arrow_back</span></button>
            <button class="carousel-btn carousel-btn--next" id="story-next" aria-label="Next story"><span class="material-symbols-rounded" aria-hidden="true">arrow_forward</span></button>
          </div>
        </div>
      </div>
      <div class="stories-carousel" id="stories-carousel" aria-live="polite" aria-label="Patient stories">
        <article class="story-slide story-slide--written active" aria-label="1 of 2: Amy Jensen">
          <a href={url(edit.text("link-cf52a071c3", "/stories/amy-jensen.html"))} class="story-media" aria-label="Read Amy's story">
            <img src={url(edit.image("image-ce45fd460b", "/images/story-amy-jensen.jpg"))} alt={edit.imageAlt("image-ce45fd460b", "Amy Jensen with her husband Chad and their son Jacob")} loading="lazy" decoding="async">
          </a>
          <div class="story-text">
            <span class="story-kicker">{edit.text("text-00e2e91ac8", "Breast cancer")}</span>
            <h3 class="story-quote">{edit.text("text-3fa8f059d4", "Facing cancer while growing a family")}</h3>
            <p class="story-excerpt">{edit.text("text-2f8392141e", "Amy navigated a breast cancer diagnosis during pregnancy with support from her family and care team.")}</p>
            <span class="story-name">{edit.text("text-9c3b94c3aa", "Amy Jensen")}</span>
            <a href={url(edit.text("link-cf52a071c3-1", "/stories/amy-jensen.html"))} class="story-link">{edit.text("text-217b252d14", "Read Amy’s story ")}<span class="material-symbols-rounded" aria-hidden="true">arrow_forward</span></a>
          </div>
        </article>
        <article class="story-slide story-slide--written" aria-label="2 of 2: Dukhi Hong">
          <a href={url(edit.text("link-9ca77d9084", "/stories/dukhi-hong.html"))} class="story-media" aria-label="Read Dukhi's story">
            <img src={url(edit.image("image-741de34811", "/images/story-dukhi-hong.jpg"))} alt={edit.imageAlt("image-741de34811", "Dukhi Hong pictured with two loved ones")} loading="lazy" decoding="async">
          </a>
          <div class="story-text">
            <span class="story-kicker">{edit.text("text-c2c63e8777", "Small cell lung cancer")}</span>
            <h3 class="story-quote">{edit.text("text-0a698fa025", "A milestone of hope")}</h3>
            <p class="story-excerpt">{edit.text("text-52600e5bca", "At 84, Dukhi marked her 100th immunotherapy treatment with the people who had supported her along the way.")}</p>
            <span class="story-name">{edit.text("text-807f154e96", "Dukhi Hong")}</span>
