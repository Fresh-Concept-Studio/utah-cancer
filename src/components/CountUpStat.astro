---
interface Props { value: number; suffix?: string }
const { value, suffix = '' } = Astro.props;
const display = `${value}${suffix}`;
---
<div class="number-value" data-count-up={value} data-count-up-suffix={suffix}>
  <span class="count-up-visual" aria-hidden="true">
    <span class="count-up-size">{display}</span>
    <span class="count-up-display" data-count-up-display>{display}</span>
  </span>
  <span class="count-up-accessible">{display}</span>
</div>

<style>
  .count-up-visual { display: inline-block; position: relative; font-variant-numeric: tabular-nums; }
  .count-up-display { position: absolute; inset: 0; }
  .count-up-size { visibility: hidden; }
  .count-up-accessible {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
</style>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  // The final values stay readable without JavaScript or motion support.
  if (!reducedMotion.matches && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(entries => {
      for (const entry of entries) {
        if (!entry.isIntersecting || entry.intersectionRatio < 0.5) continue;
        const stat = entry.target as HTMLElement;
        observer.unobserve(stat); // Play once per page visit, including on mobile.
        if (reducedMotion.matches) continue;

        const display = stat.querySelector<HTMLElement>('[data-count-up-display]');
        if (!display) continue;
        const target = Number(stat.dataset.countUp);
        const suffix = stat.dataset.countUpSuffix ?? '';
        const started = performance.now();
        display.textContent = `0${suffix}`;

        const tick = (now: number) => {
          const progress = reducedMotion.matches ? 1 : Math.min((now - started) / 700, 1);
          const eased = 1 - Math.pow(1 - progress, 3);
          display.textContent = `${Math.round(target * eased)}${suffix}`;
          if (progress < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      }
    }, { threshold: 0.5, rootMargin: '0px 0px -40px 0px' });

    document.querySelectorAll<HTMLElement>('[data-count-up]').forEach(stat => observer.observe(stat));
  }
</script>
