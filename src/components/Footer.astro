---
import { url } from '../lib/urls';
---
<footer class="footer">
    <div class="container footer-inner">
      <div class="footer-left">
        <img src={url("/images/ucs-logo-white.svg")} alt="Utah Cancer Specialists" class="footer-logo" width="589" height="192" loading="lazy" decoding="async">
        <p class="footer-tagline">Your health, our priority</p>
        <p class="footer-tagline-desc">Experience personalized care and advanced treatments. Schedule your consultation today for a healthier tomorrow.</p>
      </div>
      <div class="footer-right">
        <div class="footer-columns">
          <div class="footer-col">
            <p class="footer-col-title">About Us</p>
            <ul class="footer-links">
              <li><a href={url("/about.html")}>Our Mission</a></li>
            </ul>
          </div>
          <div class="footer-col">
            <p class="footer-col-title">Patient Care</p>
            <ul class="footer-links">
              <li><a href={url("/newly-diagnosed.html")}>Newly Diagnosed</a></li>
              <li><a href={url("/telehealth.html")}>Telehealth</a></li>
              <li><a href={url("/patient-education.html")}>Patient Education</a></li>
              <li><a href={url("/patient-resources.html")}>Patient Resources</a></li>
            </ul>
          </div>
          <div class="footer-col">
            <p class="footer-col-title">Research</p>
            <ul class="footer-links">
              <li><a href={url("/clinical-trials.html")}>Clinical Trials</a></li>
              <li><a href={url("/programs-and-services.html")}>Programs</a></li>
              <li><a href={url("/careers.html")}>Careers</a></li>
              <li><a href={url("/contact.html")}>Contact</a></li>
            </ul>
          </div>
        </div>
        <div class="footer-contact">
          <p class="footer-address">10808 S. River Front Pkwy., Ste. 400<br>South Jordan, UT 84095</p>
          <div class="footer-contact-info">
            <p><span class="footer-contact-label">Phone:</span> <a href="tel:8012690231">801.269.0231</a></p>
            <p><span class="footer-contact-label">Email:</span> <a href="mailto:info@utcancer.com">info@utcancer.com</a></p>
          </div>
          <div class="footer-social">
            <a href="https://www.facebook.com/utahcancerspecialists" target="_blank" rel="noopener" aria-label="Facebook"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 8h3V4h-3c-3.3 0-5 2-5 5v2H6v4h3v7h4v-7h3.2l.8-4h-4V9.5c0-1 .3-1.5 1-1.5Z" /></svg></a>
