---
import { pageEditor } from '../lib/page-content';
const edit = pageEditor(Astro.props.page);
import { url } from '../lib/urls';
import { providers } from '../lib/content';
import { providerCategories } from '../data/navigation';
const ordered = [...providers].sort((a,b) => a.directory.order - b.directory.order);
---
<!-- Hero -->
  <section class="providers-hero">
    <div class="container">
      <h1 class="providers-hero-title">{edit.text("text-85be06b797", "Our Providers")}</h1>
      <p class="providers-hero-desc">{edit.text("text-afc2f54941", "Board-certified oncologists, radiation specialists, advanced practitioners, and supportive and rehabilitative care professionals dedicated to every aspect of your care.")}</p>
    </div>
  </section>

  <!-- Main Content with Sidebar -->
  <section class="spec-layout">
    <div class="container spec-layout-inner">

      <!-- Left Sidebar -->
      <aside class="spec-sidebar">
        <div class="spec-sidebar-sticky">

          <!-- Search -->
          <div class="spec-search">
            <span class="material-symbols-rounded spec-search-icon">search</span>
            <input type="text" id="spec-search" class="spec-search-input" placeholder="Search providers...">
          </div>

          <!-- Categories -->
          <div class="spec-filter-group">
            <h2 class="spec-filter-title">{edit.text("text-6ccb60071b", "Categories")}</h2>
            <ul class="spec-filter-list">
  <li><button class="spec-filter-btn active" data-filter="all">All Providers <span class="spec-filter-count">{providers.length}</span></button></li>
  {providerCategories.map(category => <li><button class="spec-filter-btn" data-filter={category.id}>{category.label} <span class="spec-filter-count">{providers.filter(p => p.directory.category === category.id).length}</span></button></li>)}
</ul>
          </div>

          <!-- Quick Links -->
          <div class="spec-filter-group">
            <h3 class="spec-filter-title">{edit.text("text-917bcf00a5", "Quick Links")}</h3>
            <ul class="spec-filter-list spec-filter-list--links">{providerCategories.map(category => <li><a href={`#${category.id}`}>{category.label}</a></li>)}</ul>
          </div>

          <!-- Help CTA -->
          <div class="spec-sidebar-cta">
            <span class="material-symbols-rounded">help</span>
            <h4>{edit.text("text-11b1663be0", "Need help finding a provider?")}</h4>
            <p>{edit.text("text-99c004fc9a", "Our team can help match you with the right specialist for your needs.")}</p>
            <a href={url(edit.text("link-0fc44bd2ab", "tel:8012690231"))} class="btn btn--primary btn--full btn--sm">
              <span class="material-symbols-rounded">phone</span>{edit.text("text-2939f80944", " Call 801.269.0231 ")}</a>
          </div>

        </div>
      </aside>

      <!-- Right Content -->
      <div class="spec-content">

        <div class="spec-results-bar" id="spec-results-bar">
          <span id="spec-results-count">{edit.text("text-cf9e6df097", "Showing all ")}{providers.length}{edit.text("text-4dc1cf56c6", " providers")}</span>
        </div>

      <!-- Medical Oncology and Hematology -->
      {providerCategories.map(category => <div class="provider-category" data-category={category.id} id={category.id}>
  <h2 class="provider-category-title">{category.label}</h2>
  <div class="providers-grid">{ordered.filter(p => p.directory.category === category.id).map(provider => <a href={url(`/providers/${provider.slug}.html`)} class="provider-card" data-sort-priority={provider.directory.priority || undefined}>
    <div class="provider-card-photo"><img src={url(provider.directory.photo)} width="400" height="600" alt={provider.directory.alt} loading="lazy" decoding="async" /></div>
    <div class="provider-card-info"><h3 class="provider-card-name">{provider.name}</h3></div>
  </a>)}</div>
</div>)}

      <!-- Radiation Oncology -->

      <!-- Supportive and Rehabilitative Care -->

      <!-- Advanced Practitioners -->

      </div><!-- /.spec-content -->
    </div>
  </section>
