---
import pages from '../../lib/pages';
import Page from '../../components/Page.astro';
export function getStaticPaths() {
  return Object.keys(pages).filter(path => path.endsWith('/index.html'))
    .map(path => ({ params: { section: path.split('/')[0] }, props: { path } }));
}
---
<Page path={Astro.props.path} />
