      "value": " Hypofractionated RT"
    },
    {
      "key": "text-30ce476472",
      "label": "Text",
      "section": "Pinpoint accuracy. Maximum precision.",
      "value": "Omni Legend Digital PET/CT"
    },
    {
      "key": "text-74072dd358",
      "label": "Heading",
      "section": "Pinpoint accuracy. Maximum precision.",
      "value": "See more. Expose less."
    },
    {
      "key": "text-046aed87c8",
      "label": "Paragraph",
      "section": "Pinpoint accuracy. Maximum precision.",
      "value": "The Omni Legend PET/CT scanner uses Precision DL (deep learning) image processing and an AI-based Auto Positioning Camera for ultra-fast scanning at lower radiation doses. Its industry-leading sensitivity per centimeter enables advanced small-lesion detection and low-contrast detectability."
    },
    {
      "key": "text-97ee3d72e0",
      "label": "Paragraph",
      "section": "Pinpoint accuracy. Maximum precision.",
      "value": "Q-Clear image reconstruction with motion-free technology provides precise tumor measurement for confident diagnosis and treatment response monitoring."
    },
    {
