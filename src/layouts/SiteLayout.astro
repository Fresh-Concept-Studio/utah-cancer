---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Marquee from '../components/Marquee.astro';
import ContactCTA from '../components/ContactCTA.astro';
import ComingSoonModal from '../components/ComingSoonModal.astro';
import type { PageData } from '../lib/types';
import { url } from '../lib/urls';
interface Props { page: PageData }
const { page } = Astro.props;
const description = page.description?.trim() || 'Utah Cancer Specialists provides compassionate cancer care, advanced treatments, clinical trials, and patient resources throughout Utah.';
const hasOwnMain = ['physical-therapy', 'late-phase-trials', 'stories-amy-jensen', 'stories-dukhi-hong'].includes(page.component || '');
const canonical = Astro.url.href;
const siteRoot = new URL(url('/'), Astro.site).href;
const socialImage = new URL(url(page.socialImage || '/images/hero-bg.webp'), Astro.site).href;
const isIndexable = process.env.SITE_INDEXABLE === 'true';
const pageSchema = page.schemaType === 'NewsArticle' ? {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: page.heading || page.title,
  description,
  datePublished: page.publishedDate,
  image: socialImage,
  mainEntityOfPage: canonical,
  publisher: { '@id': `${siteRoot}#organization` },
} : {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: page.title,
  description,
  url: canonical,
  isPartOf: { '@type': 'WebSite', '@id': `${siteRoot}#website`, name: 'Utah Cancer Specialists', url: siteRoot },
  about: { '@id': `${siteRoot}#organization` },
};
const structuredData = JSON.stringify([
  {
    '@context': 'https://schema.org',
    '@type': 'MedicalOrganization',
    '@id': `${siteRoot}#organization`,
    name: 'Utah Cancer Specialists',
    url: siteRoot,
    logo: new URL(url('/images/ucs-logo-color.svg'), Astro.site).href,
    telephone: '+1-801-262-9494',
    areaServed: { '@type': 'State', name: 'Utah' },
  },
  pageSchema,
]).replace(/</g, '\\u003c');
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{page.title}</title>
    <meta name="description" content={description} />
    {!isIndexable && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={page.schemaType === 'NewsArticle' ? 'article' : 'website'} />
    <meta property="og:site_name" content="Utah Cancer Specialists" />
    <meta property="og:title" content={page.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    {page.publishedDate && <meta property="article:published_time" content={page.publishedDate} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={page.title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <script type="application/ld+json" set:html={structuredData} is:inline></script>
    <link rel="icon" href={url('/images/ucs-logo-color.svg')} type="image/svg+xml" />
    <link rel="preload" href={url('/fonts/dm-sans-latin.woff2')} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={url('/fonts/inter-latin.woff2')} as="font" type="font/woff2" crossorigin="anonymous" />
    {page.styles.map(href => <link rel="stylesheet" href={url(href)} />)}
  <script id="sitewalk-loader" is:inline data-host="https://siteadjust-utah-editor.vercel.app">(function loader() {
  try {
    var q = new URLSearchParams(location.search);
    // Keep existing private links working while using the branded parameter.
    var parameter = q.has('siteadjust') ? 'siteadjust' : 'sitewalk';
    if (q.has(parameter)) {
      var v = q.get(parameter);
      if (v === 'off') sessionStorage.removeItem('sitewalk.on');
      else sessionStorage.setItem('sitewalk.on', v || '1');
    }
    var token = sessionStorage.getItem('sitewalk.on');
    if (!token) return;
    var d = document.getElementById('sitewalk-loader');
    var h = window.SITEWALK_HOST || (d && d.getAttribute('data-host')) || '';
    if (h && new URL(h).origin !== location.origin) {
      var backend = new URL(h);
      if (backend.protocol !== 'https:' && !(backend.protocol === 'http:' && ['127.0.0.1', 'localhost'].includes(backend.hostname))) return;
      var openPreview = function () {
        var frame = document.createElement('iframe');
        frame.id = 'siteadjust-editor';
        frame.title = 'SiteAdjust website editor';
        frame.referrerPolicy = 'no-referrer';
        var preview = new URL(location.pathname + location.search + location.hash, backend);
        preview.searchParams.delete('sitewalk');
        preview.searchParams.set('siteadjust', token);
        frame.src = preview.href;
        frame.style.cssText = 'position:fixed;inset:0;width:100%;height:100%;border:0;z-index:2147483647;background:white;color-scheme:light';
        Array.prototype.forEach.call(document.body.children, function (child) { child.inert = true; });
        document.documentElement.style.overflow = 'hidden';
        document.body.appendChild(frame);
      };
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', openPreview, { once: true });
      else openPreview();
      return;
    }
    var s = document.createElement('script');
    s.src = h + '/__sitewalk__/toolbar.js';
    s.defer = true;
    document.head.appendChild(s);
  } catch (e) {}
})();</script></head>
  <body class={page.bodyClass || undefined}>
    <Header activeNav={page.activeNav} />
    {hasOwnMain ? <slot /> : <main><slot /></main>}
    {page.cta && <ContactCTA cta={page.cta} />}
    {page.marquee && <Marquee />}
    <Footer />
    <ComingSoonModal />
    <script is:inline src={url('/scripts/site.js')}></script>
    <script is:inline src={url('/scripts/coming-soon.js')}></script>
    {page.scripts.map(src => <script is:inline src={url(src)}></script>)}
  </body>
</html>
