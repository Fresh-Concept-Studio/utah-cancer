---
import { url } from '../lib/urls';
---
<section class="providers-hero">
    <div class="container">
      <h1 class="providers-hero-title">Patient Resources</h1>
      <p class="providers-hero-desc">A collection of resources to support you through every stage of your cancer journey — from diagnosis through treatment and into survivorship.</p>
      <div class="pr-hero-meta">
        <div class="pr-hero-meta-item"><span class="material-symbols-rounded">apps</span><span>Six core resources</span></div>
        <div class="pr-hero-meta-item"><span class="material-symbols-rounded">schedule</span><span>24/7 portal access</span></div>
        <div class="pr-hero-meta-item"><span class="material-symbols-rounded">support_agent</span><span>Patient advocates on call</span></div>
      </div>
    </div>
  </section>

  <section class="pr-bento-section">
    <div class="container">
      <div class="pr-bento-header">
        <div>
          <span class="pr-eyebrow">Everything you need</span>
          <h2 class="pr-section-title">A change built around your care.</h2>
        </div>
        <p class="pr-section-sub">Resources to help you stay connected, informed, and supported — from secure messaging with your care team to community programs that go beyond the clinic.</p>
      </div>

      <div class="pr-bento">
        <a href="https://www.navigatingcare.com/navigatingcare/" target="_blank" rel="noopener" class="pr-card pr-card--feature">
          <div class="pr-card-feature-top">
            <div class="pr-card-icon"><span class="material-symbols-rounded">person</span></div>
            <div>
              <span class="pr-card-eyebrow">Most used · 24/7 access</span>
              <h3>Patient Portal</h3>
              <p>Secure access to your health records, lab results, medications, and direct messaging with your care team — all in one place, any time.</p>
            </div>
          </div>
          <div class="pr-card-feature-bottom">
            <span class="pr-feature-cta">Log in to your portal <span class="material-symbols-rounded">arrow_forward</span></span>
          </div>
        </a>

        <a href="#" class="pr-card pr-card--side">
          <span class="pr-card-num">02</span>
          <div class="pr-card-icon"><span class="material-symbols-rounded">volunteer_activism</span></div>
          <h3>Patient Advocacy</h3>
          <p>Your personal liaison — insurance, authorizations, and support throughout treatment.</p>
          <span class="pr-card-arrow"><span class="material-symbols-rounded">arrow_outward</span></span>
        </a>

        <div class="pr-card pr-card--side">
          <a href="https://mypay.poscorp.com/UtahCancer#/account/login?guestPay=v2" target="_blank" rel="noopener" class="pr-card-link" aria-label="Billing and Quick Pay"></a>
          <span class="pr-card-num">03</span>
          <div class="pr-card-icon"><span class="material-symbols-rounded">payments</span></div>
          <h3>Billing &amp; Quick Pay</h3>
          <p>View statements, make secure payments, and set up autopay.</p>
          <a href="https://utahcanceronline.ci.healthpay24.cloud/account/login" target="_blank" rel="noopener" class="pr-card-secondary">or enroll in eStatements <span class="material-symbols-rounded">arrow_outward</span></a>
          <span class="pr-card-arrow"><span class="material-symbols-rounded">arrow_outward</span></span>
        </div>

        <a href={url("/telehealth.html")} class="pr-card pr-card--bottom">
          <span class="pr-card-num">04</span>
          <div class="pr-card-icon"><span class="material-symbols-rounded">videocam</span></div>
          <h3>Telehealth</h3>
          <p>Virtual visits from home — simple, direct, on any smartphone or tablet.</p>
          <span class="pr-card-arrow"><span class="material-symbols-rounded">arrow_outward</span></span>
        </a>

        <a href={url("/patient-education.html")} class="pr-card pr-card--bottom">
          <span class="pr-card-num">05</span>
          <div class="pr-card-icon"><span class="material-symbols-rounded">school</span></div>
          <h3>Education &amp; Videos</h3>
          <p>Resources to help you understand your diagnosis, treatment, and what to expect.</p>
          <span class="pr-card-arrow"><span class="material-symbols-rounded">arrow_outward</span></span>
        </a>

        <a href={url("/programs-and-services.html")} class="pr-card pr-card--bottom">
          <span class="pr-card-num">06</span>
          <div class="pr-card-icon"><span class="material-symbols-rounded">group</span></div>
          <h3>Programs &amp; Support</h3>
          <p>Support groups, breathwork, nutrition, and community programs for patients and caregivers.</p>
          <span class="pr-card-arrow"><span class="material-symbols-rounded">arrow_outward</span></span>
        </a>
      </div>
    </div>
  </section>

  <section class="pr-bento-section" style="padding-top: 0;">
    <div class="container">
      <a href={url("/physical-therapy.html")} class="pr-card">
        <div class="pr-card-icon"><span class="material-symbols-rounded" aria-hidden="true">directions_walk</span></div>
        <h3>Physical Therapy</h3>
        <p>Cancer-focused rehabilitation at Sandy Clinic, with personalized support for movement, energy, and daily activities during treatment and recovery.</p>
        <span class="pr-card-arrow"><span class="material-symbols-rounded" aria-hidden="true">arrow_outward</span></span>
      </a>
    </div>
  </section>

  <section class="pr-community-section">
    <div class="container">
      <div class="pr-community-wrap">
        <div class="pr-community-head">
          <div>
            <span class="pr-eyebrow">Beyond Utah Cancer</span>
            <h2 class="pr-community-title">Trusted external resources.</h2>
          </div>
          <p class="pr-community-note">The following external organizations may be helpful. Inclusion does not imply endorsement by Utah Cancer Specialists.</p>
        </div>
        <div class="pr-community-list">
          <a href="#" class="pr-community-link" target="_blank" rel="noopener">
            <div class="pr-community-link-text">
              <h4>American Cancer Society</h4>
              <p>Information, support, and resources for cancer patients and families.</p>
            </div>
            <span class="pr-community-link-ext"><span class="material-symbols-rounded">arrow_outward</span></span>
          </a>
          <a href="#" class="pr-community-link" target="_blank" rel="noopener">
            <div class="pr-community-link-text">
              <h4>National Cancer Institute</h4>
              <p>Comprehensive cancer information from the U.S. government.</p>
            </div>
            <span class="pr-community-link-ext"><span class="material-symbols-rounded">arrow_outward</span></span>
          </a>
          <a href="#" class="pr-community-link" target="_blank" rel="noopener">
            <div class="pr-community-link-text">
              <h4>CancerCare</h4>
              <p>Free professional support including counseling, support groups, and financial assistance.</p>
            </div>
            <span class="pr-community-link-ext"><span class="material-symbols-rounded">arrow_outward</span></span>
          </a>
          <a href="#" class="pr-community-link" target="_blank" rel="noopener">
            <div class="pr-community-link-text">
              <h4>Utah Cancer Foundation</h4>
              <p>Local support programs and financial assistance for Utah cancer patients.</p>
            </div>
            <span class="pr-community-link-ext"><span class="material-symbols-rounded">arrow_outward</span></span>
          </a>
        </div>
      </div>
    </div>
  </section>
