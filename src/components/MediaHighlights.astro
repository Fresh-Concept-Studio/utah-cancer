---
import { mediaHighlights } from '../lib/content';
import { url } from '../lib/urls';
import { pageEditor } from '../lib/page-content';
const edit=pageEditor(Astro.props.page);
---
<aside class="media-breaker" id="media">
  <a href={edit.text("media-feature-url", "https://youtu.be/SX070PNyqUE")} class="media-breaker-video" aria-label={edit.text("media-feature-label", "KSL at Noon")} target="_blank" rel="noopener">
    <img src={url(edit.image("media-feature-photo", "/images/media-interview-640.webp"))} width="640" height="427" alt={edit.imageAlt("media-feature-photo", "A Utah Cancer Specialists physician interviewed on a TV news set")} loading="lazy" decoding="async">
    <span class="media-breaker-play"><span class="material-symbols-rounded">play_arrow</span></span>
    <span class="media-breaker-soon">{edit.text("media-feature-label", "KSL at Noon")}</span>
  </a>
  <span class="media-breaker-text">
    <span class="media-breaker-title">{edit.text("media-heading", "Media Highlights")}</span>
    <span class="media-breaker-desc">{edit.text("media-description", "Our physicians share the latest in cancer care on Utah\u2019s news networks.")}</span>
    <span class="media-breaker-links" aria-label="Utah Cancer Specialists media appearances">
      {mediaHighlights.map(video => video.instagram ?
        <span class="media-breaker-item">
          <span>{video.label}</span>
          <span class="media-breaker-platforms">
            <a href={video.href} target="_blank" rel="noopener">YouTube</a>
            <a href={video.instagram} target="_blank" rel="noopener">Instagram</a>
          </span>
        </span> :
        <a class="media-breaker-item" href={video.href} target="_blank" rel="noopener">
          <span>{video.label}</span>
          <span class="material-symbols-rounded" aria-hidden="true">arrow_outward</span>
        </a>
      )}
    </span>
    <span class="media-breaker-outlets">
      <span class="media-breaker-outlets-label">As seen on these outlets</span>
      <span class="media-breaker-logos">
        <span class="media-breaker-logo"><img src={url("/images/logos/ksl.svg")} width="200" height="200" alt="KSL News" loading="lazy" decoding="async"></span>
        <span class="media-breaker-logo"><img src={url("/images/logos/fox13.svg")} width="80" height="42" alt="FOX 13" loading="lazy" decoding="async"></span>
        <span class="media-breaker-logo"><img src={url("/images/logos/abc4-100.webp")} width="100" height="96" alt="ABC4 Utah" loading="lazy" decoding="async"></span>
        <span class="media-breaker-logo media-breaker-logotype">Good Things <strong>Utah</strong></span>
      </span>
    </span>
  </span>
</aside>
