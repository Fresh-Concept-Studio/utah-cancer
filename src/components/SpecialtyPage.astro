---
import specialties from '../data/specialties.json';
import { url, richHtml } from '../lib/urls';
import DetailSections from './DetailSections.astro';
import DetailTabs from './DetailTabs.astro';
import SharedContent from './SharedContent.astro';
import ContentLink from './ContentLink.astro';
interface Props { slug: string }
const specialty = specialties.find(p => p.slug === Astro.props.slug);
if (!specialty) throw new Error(`Unknown specialty: ${Astro.props.slug}`);
---
<section class="sd-hero">
  <div class="sd-hero-bg"><img src={url(specialty.image)} alt="" /><div class="sd-hero-overlay"></div></div>
  <div class="container sd-hero-inner">
    <a href={url('/specialties/index.html')} class="provider-breadcrumb"><span class="material-symbols-rounded">arrow_back</span> All Specialties</a>
    <span class="sd-hero-tag">{specialty.category}</span>
    <h1 class="sd-hero-title">{specialty.title}</h1><p class="sd-hero-sub">{specialty.description}</p>
    <div class="sd-hero-actions">{specialty.actions.map(link => <ContentLink link={link} />)}</div>
  </div>
</section>
<DetailTabs tabs={specialty.tabs} />
<section class="provider-details"><div class="container provider-details-inner">
  <div class="provider-main"><DetailSections sections={specialty.sections} /></div>
  <SharedContent name={specialty.sidebar} />
</div></section>
<Fragment set:html={richHtml(specialty.relatedHtml)} />
