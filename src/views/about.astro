---
import { pageEditor } from '../lib/page-content';
const edit = pageEditor(Astro.props.page);
import { url } from '../lib/urls';
import CountUpStat from '../components/CountUpStat.astro';
// HR total supplied by Sandy Jones on September 16, 2026.
const employeeCount = edit.number("stat-employees", 382);
---
<!-- Hero -->
  <section class="about-hero">
    <div class="about-hero-bg">
      <img
        src={url(edit.image("image-01b7dc653d", "/images/hero-bg.webp"))}
        srcset={edit.imageChanged("image-01b7dc653d", "/images/hero-bg.webp") ? undefined : `${url("/images/hero-bg-720.webp")} 720w, ${url("/images/hero-bg.webp")} 1536w`}
        sizes="100vw"
        width="1536"
        height="1024"
        alt={edit.imageAlt("image-01b7dc653d", "")}
        fetchpriority="high"
        decoding="async"
      >
      <div class="about-hero-overlay"></div>
    </div>
    <div class="container about-hero-inner">
      <span class="about-hero-label">{edit.text("text-0725656979", "About Utah Cancer Specialists")}</span>
      <h1 class="about-hero-title">{edit.text("text-975d8fc701", "Caring for people")}<br>{edit.text("text-a946cecf8f", "confronting cancer.")}</h1>
      <p class="about-hero-sub">{edit.text("text-b46054a527", "Utah's largest community-based oncology practice, providing advanced, compassionate cancer care across the Intermountain West since 1994.")}</p>
    </div>
  </section>

  <!-- Mission -->
  <section class="about-mission">
    <div class="container about-mission-inner">
      <div class="about-mission-text">
        <span class="about-mission-label">{edit.text("text-e36a913a36", "Our Mission")}</span>
        <h2 class="about-mission-title">{edit.text("text-25a5e8c94b", "A clear path to hope and healing")}</h2>
        <p class="about-mission-body">{edit.text("text-d3448862e0", "Choosing a path for your cancer treatment can be overwhelming. At Utah Cancer Specialists, our experienced team of physicians and caring professionals will help you make the best decisions for your journey — with the latest treatments, honest guidance, and a commitment to your whole well-being.")}</p>
        <p class="about-mission-body">{edit.text("text-dac0d6d018", "We believe cancer care means more than medications and therapies. As comprehensive cancer care providers, we address the emotional and physical impact of your disease and prepare you for a healthier life after treatment. We are united by a singular focus: helping every patient find a clear path to hope and healing.")}</p>
      </div>
      <div class="about-mission-photos">
        <div class="about-mission-photo">
          <img src={url(edit.image("image-ad25028388", "/images/specialty-prostate-clinical-card-480.webp"))} width="480" height="640" alt={edit.imageAlt("image-ad25028388", "Patient receiving care from a UCS clinician")} loading="lazy" decoding="async">
        </div>
        <div class="about-mission-photo">
          <img src={url(edit.image("image-ef47ce2ded", "/images/specialty-headneck-clinical-card-480.webp"))} width="480" height="640" alt={edit.imageAlt("image-ef47ce2ded", "UCS clinician in a care setting")} loading="lazy" decoding="async">
        </div>
        <div class="about-mission-photo">
          <img src={url(edit.image("image-ce90afdf7f", "/images/specialty-kidney-clinical-card-480.webp"))} width="480" height="640" alt={edit.imageAlt("image-ce90afdf7f", "UCS care team member in the infusion center")} loading="lazy" decoding="async">
        </div>
      </div>
    </div>
  </section>

  <!-- Quote -->
  <section class="about-quote">
    <div class="container">
      <blockquote>{edit.text("text-d03dfafb5e", "“Cancer is a journey. We’re with you every step of the way.”")}</blockquote>
      <cite>{edit.text("text-392824a385", "— Utah Cancer Specialists")}</cite>
    </div>
  </section>

  <!-- By the Numbers -->
  <section class="about-numbers">
    <div class="container about-numbers-inner">
      <div class="about-numbers-image">
        <img src={url(edit.image("image-1af6df1144", "/images/location-jordan-valley-640.webp"))} width="640" height="640" alt={edit.imageAlt("image-1af6df1144", "Jordan Valley Cancer Center")} loading="lazy" decoding="async">
      </div>
      <div>
        <span class="about-mission-label">{edit.text("text-dae0a5de11", "By the Numbers")}</span>
        <h2 class="about-mission-title" style="margin-bottom: 36px;">{edit.text("text-44677ef0ad", "The scope of our impact")}</h2>
        <div class="numbers-grid">
          <div class="number-item">
            <CountUpStat value={edit.number("stat-years", 30)} suffix="+" />
            <div class="number-label">{edit.text("text-fac49e5404", "Years serving Utah families since 1994")}</div>
          </div>
          <div class="number-item">
            <CountUpStat value={edit.number("stat-locations", 13)} />
            <div class="number-label">{edit.text("text-c1ce5e1753", "Locations across Utah")}</div>
          </div>
          <div class="number-item">
            <CountUpStat value={edit.number("stat-providers", 60)} suffix="+" />
            <div class="number-label">{edit.text("text-c74b997e45", "Physicians and advanced practitioners")}</div>
          </div>
          <div class="number-item">
            <CountUpStat value={edit.number("stat-trials", 50)} suffix="+" />
            <div class="number-label">{edit.text("text-1171e9ea2f", "Active clinical trials at any given time")}</div>
          </div>
          <div class="number-item">
            <CountUpStat value={employeeCount} />
            <div class="number-label">{edit.text("text-f86e283386", "Dedicated employees across all locations")}</div>
          </div>
          <div class="number-item">
            <CountUpStat value={edit.number("stat-certified", 100)} suffix="%" />
            <div class="number-label">{edit.text("text-7499251e82", "Board-certified oncology specialists")}</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Our Story Timeline -->
  <section class="about-story">
    <div class="container">
      <div class="about-story-header">
        <h2 class="about-story-title">{edit.text("text-c8927cf4e8", "Our Story")}</h2>
        <p class="about-story-desc">{edit.text("text-a9e7242e43", "From a small group of dedicated oncologists to the Intermountain West's largest community cancer practice.")}</p>
      </div>
      <div class="timeline">
        <div class="timeline-item">
          <div class="timeline-dot"></div>
          <div class="timeline-content">
            <div class="timeline-year">{edit.text("text-5a478022f3", "1994")}</div>
            <div class="timeline-text">{edit.text("text-50b9920d9b", "Utah Cancer Specialists is founded by a small group of oncologists committed to bringing expert, community-based cancer care closer to where patients live and work along the Wasatch Front.")}</div>
          </div>
        </div>
        <div class="timeline-item">
          <div class="timeline-dot"></div>
          <div class="timeline-content">
            <div class="timeline-year">{edit.text("text-5eb8cda1f8", "2000s")}</div>
            <div class="timeline-text">{edit.text("text-4b01d696ea", "The practice expands to multiple locations, partnering with hospitals throughout the region, and launches its clinical research program to give patients access to emerging therapies.")}</div>
          </div>
        </div>
        <div class="timeline-item">
          <div class="timeline-dot"></div>
          <div class="timeline-content">
            <div class="timeline-year">{edit.text("text-527dc687fa", "2008")}</div>
            <div class="timeline-text">{edit.text("text-7364147b8b", "UCS opens its in-house oral oncology pharmacy, becoming one of the first community oncology practices in the region to offer medically integrated dispensing — ensuring patients receive medications with direct pharmacist-oncologist collaboration.")}</div>
          </div>
        </div>
        <div class="timeline-item">
          <div class="timeline-dot"></div>
          <div class="timeline-content">
            <div class="timeline-year">{edit.text("text-ab39c54239", "2016")}</div>
            <div class="timeline-text">{edit.text("text-1d28486551", "The Jordan Valley Cancer Center opens — a purpose-built, two-story facility designed around patient comfort, with a hospitality-inspired environment featuring natural healing elements of earth, water, and wood.")}</div>
          </div>
        </div>
        <div class="timeline-item">
          <div class="timeline-dot"></div>
          <div class="timeline-content">
            <div class="timeline-year">{edit.text("text-85568b20c3", "2020")}</div>
            <div class="timeline-text">{edit.text("text-fbc6a28702", "UCS becomes a founding site for the START Mountain Region early-phase clinical trial program — the only dedicated community-based early-phase trial center in Utah, led by Dr. Justin Call.")}</div>
          </div>
        </div>
        <div class="timeline-item">
          <div class="timeline-dot"></div>
          <div class="timeline-content">
            <div class="timeline-year">{edit.text("text-24345a1437", "Today")}</div>
            <div class="timeline-text">{edit.text("text-395e890d99", "With 13 locations across Utah, and ")}{employeeCount}{edit.text("text-72822bdde1", " team members, UCS is the largest community-based oncology practice in the Intermountain West — offering medical oncology, radiation therapy, clinical trials, and integrated support services.")}</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="about-values">
    <div class="container">
      <div class="about-values-header">
        <span class="about-values-label">{edit.text("text-4d8d79d644", "What Guides Us")}</span>
        <h2 class="about-values-title">{edit.text("text-28f73309e3", "Built on principles that put patients first")}</h2>
      </div>
      <div class="values-grid">
        <div class="value-card">
          <div class="value-icon"><span class="material-symbols-rounded">favorite</span></div>
          <h3 class="value-title">{edit.text("text-58136e3344", "Compassion First")}</h3>
          <p class="value-desc">{edit.text("text-d913f41d86", "We treat every patient the way we would want our own family treated — with warmth, dignity, and genuine care at every visit.")}</p>
        </div>
        <div class="value-card">
          <div class="value-icon"><span class="material-symbols-rounded">science</span></div>
          <h3 class="value-title">{edit.text("text-1c30032198", "Evidence-Based Excellence")}</h3>
          <p class="value-desc">{edit.text("text-a6a5cb0491", "Our specialists translate today's most promising research into tomorrow's treatments, so our patients receive the most effective, least traumatic care available.")}</p>
        </div>
        <div class="value-card">
          <div class="value-icon"><span class="material-symbols-rounded">diversity_3</span></div>
          <h3 class="value-title">{edit.text("text-71146fa32f", "A Team Approach")}</h3>
          <p class="value-desc">{edit.text("text-ec6784db69", "Oncologists, radiation specialists, nurse practitioners, pharmacists, patient advocates, and support staff — working together on a coordinated treatment plan unique to you.")}</p>
        </div>
        <div class="value-card">
          <div class="value-icon"><span class="material-symbols-rounded">location_on</span></div>
          <h3 class="value-title">{edit.text("text-a333cb1efe", "Close to Home")}</h3>
          <p class="value-desc">{edit.text("text-1b82d7633e", "With locations across Utah, we bring world-class cancer care to communities throughout the state so patients don't have to travel for treatment.")}</p>
        </div>
        <div class="value-card">
          <div class="value-icon"><span class="material-symbols-rounded">psychology</span></div>
          <h3 class="value-title">{edit.text("text-1363a5f745", "Whole-Person Care")}</h3>
          <p class="value-desc">{edit.text("text-1234288bde", "Cancer treatment is more than medicine. We offer programs and services that address nutrition, emotional health, financial counseling, and survivorship planning.")}</p>
        </div>
        <div class="value-card">
          <div class="value-icon"><span class="material-symbols-rounded">volunteer_activism</span></div>
          <h3 class="value-title">{edit.text("text-4bebaa708b", "Patient Advocacy")}</h3>
          <p class="value-desc">{edit.text("text-2882971f3e", "Our dedicated patient advocates coordinate insurance, financial assistance, and emotional support — so you can focus entirely on your treatment and recovery.")}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Technology -->
  <section class="about-tech">
    <div class="container">
      <div class="about-tech-header">
        <span class="about-mission-label">{edit.text("text-71165c2e52", "Advanced Technology")}</span>
        <h2 class="about-tech-title">{edit.text("text-3a67f7b274", "Investing in the tools that make a difference")}</h2>
        <p class="about-tech-desc">{edit.text("text-828e254890", "We continually invest in the latest diagnostic and treatment technology so our patients benefit from the most precise, effective care available.")}</p>
      </div>
      <div class="tech-cards">
        <div class="tech-card">
          <div class="tech-card-icon"><span class="material-symbols-rounded">radiology</span></div>
          <h3>{edit.text("text-61178eae22", "TrueBeam Linear Accelerator")}</h3>
          <p>{edit.text("text-bbe27a623e", "Precise, image-guided radiation treatment for lung, breast, head, neck, and other cancers — delivering targeted therapy while sparing healthy tissue.")}</p>
        </div>
        <div class="tech-card">
          <div class="tech-card-icon"><span class="material-symbols-rounded">monitor_heart</span></div>
          <h3>{edit.text("text-30ce476472", "Omni Legend Digital PET/CT")}</h3>
          <p>{edit.text("text-1fff30a936", "AI-powered imaging with auto-positioning camera technology that reduces radiation exposure and dosing time while delivering detailed diagnostic scans.")}</p>
        </div>
        <div class="tech-card">
          <div class="tech-card-icon"><span class="material-symbols-rounded">biotech</span></div>
          <h3>{edit.text("text-af4322fba2", "START Early-Phase Trials")}</h3>
          <p>{edit.text("text-a1f2e83299", "Utah's only dedicated community-based early-phase clinical trial site, giving patients access to cutting-edge investigational treatments close to home.")}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Leadership -->
  <section class="about-team about-leadership-feature" id="leadership">
    <div class="container about-team-inner">
      <div class="about-leadership-portraits" role="group" aria-label="Utah Cancer Specialists executive leadership team">
        <figure class="about-leadership-portrait">
          <img src={url(edit.image("image-2c1babaeee", "/images/leader-ravin-bisla.jpg"))} alt={edit.imageAlt("image-2c1babaeee", "Ravin Bisla, Chief Executive Officer")} loading="lazy" decoding="async">
          <figcaption><strong>{edit.text("text-34578686b3", "Ravin Bisla")}</strong><span>{edit.text("text-7a9fec6019", "CEO")}</span></figcaption>
        </figure>
        <figure class="about-leadership-portrait">
          <img src={url(edit.image("image-1dbe803400", "/images/leader-cfo.jpg"))} alt={edit.imageAlt("image-1dbe803400", "Patrick Shields, Chief Financial Officer")} loading="lazy" decoding="async">
          <figcaption><strong>{edit.text("text-8dc52ecc2e", "Patrick Shields")}</strong><span>{edit.text("text-f3f1496dde", "CFO")}</span></figcaption>
        </figure>
        <figure class="about-leadership-portrait">
          <img src={url(edit.image("image-1e71d2f998", "/images/leader-kyle-kitchen.jpg"))} alt={edit.imageAlt("image-1e71d2f998", "Kyle Kitchen, Chief Clinical Officer")} loading="lazy" decoding="async">
          <figcaption><strong>{edit.text("text-385950d528", "Kyle Kitchen")}</strong><span>{edit.text("text-89b394fd02", "CCO")}</span></figcaption>
        </figure>
        <figure class="about-leadership-portrait">
          <img src={url(edit.image("image-649126271f", "/images/leader-shannon-mcrae.jpg"))} alt={edit.imageAlt("image-649126271f", "Shannon McRae, Chief of Staff")} loading="lazy" decoding="async">
          <figcaption><strong>{edit.text("text-cf98a1b4fa", "Shannon McRae")}</strong><span>{edit.text("text-ab970bed2e", "Chief of Staff")}</span></figcaption>
        </figure>
      </div>
      <div class="about-team-text">
        <span class="about-leadership-label">{edit.text("text-c8164230f2", "Leadership at UCS")}</span>
        <h2>{edit.text("text-9069bae9d2", "Guiding exceptional care, together")}</h2>
        <p>{edit.text("text-44c4174f78", "Utah Cancer Specialists is led by healthcare and business executives united around one goal: giving our physicians and care teams the support they need to deliver exceptional cancer care close to home.")}</p>
        <p>{edit.text("text-a9383054a8", "Our executive leadership guides clinical quality, operations, growth, and the day-to-day work behind every UCS location across Utah.")}</p>
        <a href={url(edit.text("link-21fbe9cc12", "/leadership.html"))} class="btn btn--primary">
          <span class="material-symbols-rounded">groups</span>{edit.text("text-3700a4ecd4", " Meet Our Leadership ")}</a>
      </div>
    </div>
  </section>

  <!-- Research Section -->
  <section class="about-team" style="background: #f8f9fa; border-top: 1px solid #e8e4e0;">
    <div class="container about-team-inner reverse">
      <div class="about-team-photos about-team-photos--single">
        <div class="about-team-photo">
          <img src={url(edit.image("image-c6a08adde9", "/images/location-start-640.webp"))} width="408" height="272" alt={edit.imageAlt("image-c6a08adde9", "START Mountain Region clinical trials location")} loading="lazy" decoding="async">
        </div>
      </div>
      <div class="about-team-text">
        <h2>{edit.text("text-1334afbf00", "Advancing the future of cancer treatment")}</h2>
        <p>{edit.text("text-59433fe1d9", "Utah Cancer Specialists actively participates in clinical research, managing more than 50 active clinical trials at any given time. One of our greatest strengths is the ability to translate today's most promising laboratory findings into tomorrow's new, more effective treatments.")}</p>
        <p>{edit.text("text-571b3bb0f6", "Through the START Mountain Region program, we offer Utah's only dedicated community-based early-phase clinical trial site. Patients benefit not only from treatments that target their cancer, but therapies designed to preserve quality of life during and after treatment.")}</p>
        <a href={url(edit.text("link-f5e6f072f6", "/specialties/index.html"))} class="btn btn--primary">
          <span class="material-symbols-rounded">science</span>{edit.text("text-2a3fcccdaa", " Explore Our Specialties ")}</a>
      </div>
    </div>
  </section>
