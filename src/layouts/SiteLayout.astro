---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Marquee from '../components/Marquee.astro';
import ContactCTA from '../components/ContactCTA.astro';
import type { PageData } from '../lib/types';
import { url } from '../lib/urls';
interface Props { page: PageData }
const { page } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{page.title}</title>
    {page.description && <meta name="description" content={page.description} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Inter:wght@400;500;600&family=Almarai&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/icon?family=Material+Symbols+Rounded:opsz,wght,FILL@20..48,100..700,0..1" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />
    {page.styles.map(href => <link rel="stylesheet" href={url(href)} />)}
  </head>
  <body class={page.bodyClass || undefined}>
    <Header activeNav={page.activeNav} />
    {page.mainLandmark ? <main><slot /></main> : <slot />}
    {page.cta && <ContactCTA cta={page.cta} />}
    {page.marquee && <Marquee />}
    <Footer />
    <script is:inline src={url('/scripts/site.js')}></script>
    {page.scripts.map(src => <script is:inline src={url(src)}></script>)}
  </body>
</html>
