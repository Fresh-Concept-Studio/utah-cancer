---
import { pageEditor } from '../lib/page-content';
const edit = pageEditor(Astro.props.page);
import { url } from '../lib/urls';
---
<section class="providers-hero">
    <div class="container">
      <h1 class="providers-hero-title">{edit.text("text-84e29a2735", "Treatment Options")}</h1>
      <p class="providers-hero-desc">{edit.text("text-4f302f17b0", "Advanced, evidence-based therapies tailored to your specific cancer type, stage, and goals — with a focus on effectiveness and quality of life.")}</p>
    </div>
  </section>

  <div class="container">
    <div class="hero-bridge">
      <img src={url(edit.image("image-619d28cc0b", "/images/generated/treatment-options-hero-960.webp"))} width="960" height="640" alt={edit.imageAlt("image-619d28cc0b", "Two people review a treatment plan together at a sunlit clinic table")} fetchpriority="high" decoding="async">
    </div>
  </div>

  <!-- Intro split: mission text + stats -->
  <section class="tx-intro">
    <div class="container">
      <div class="tx-intro-inner">
        <div>
          <span class="tx-eyebrow">{edit.text("text-f09011b0e8", "Our approach")}</span>
          <h2 class="tx-intro-title">{edit.text("text-009dc3db7a", "Take an active role in your care.")}</h2>
          <p class="tx-intro-body">{edit.text("text-a5227c9bc2", "As a cancer patient, you are urged to take an active role in your care and make treatment decisions that are best for you and your loved ones.")}</p>
          <p class="tx-intro-body">{edit.text("text-447dcced56", "Our mission is to deliver compassionate, comprehensive, and patient-focused care using the latest treatment modalities — with proactive symptom management built into every plan.")}</p>
        </div>
        <div class="tx-stats">
          <div class="tx-stat">
            <div class="tx-stat-value">{edit.text("text-0ade7c2cf9", "9")}</div>
            <div class="tx-stat-label">{edit.text("text-603a3f0fcb", "Treatment modalities under one practice")}</div>
          </div>
          <div class="tx-stat">
            <div class="tx-stat-value">{edit.text("text-a53653ec06", "50+")}</div>
            <div class="tx-stat-label">{edit.text("text-6f867b721c", "Active clinical trials in progress")}</div>
          </div>
          <div class="tx-stat">
            <div class="tx-stat-value">{edit.text("text-368ace5e66", "25+")}</div>
            <div class="tx-stat-label">{edit.text("text-f9f2c98e47", "Years of community-based research")}</div>
          </div>
          <div class="tx-stat">
            <div class="tx-stat-value">{edit.text("text-fae31ecec0", "100%")}</div>
            <div class="tx-stat-label">{edit.text("text-193bea0d52", "Personalized, multidisciplinary plans")}</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Category 1: Systemic Therapies -->
  <section class="tx-cat tx-cat--gray">
    <div class="container">
      <div class="tx-cat-header">
        <div class="tx-cat-header-text">
          <span class="tx-eyebrow">{edit.text("text-99b9b64956", "Systemic therapies")}</span>
          <h2 class="tx-cat-heading">{edit.text("text-50957a4dcf", "Treating cancer throughout the body.")}</h2>
          <p class="tx-cat-sub">{edit.text("text-6228d071a7", "Drug-based modalities that travel through the bloodstream to reach cancer cells wherever they exist.")}</p>
        </div>
        <div class="tx-cat-meta">{edit.text("text-b01b7e812f", "04 modalities")}</div>
      </div>

      <div class="tx-grid-4">
        <div class="tx-card">
          <span class="tx-card-num">{edit.text("text-ddfe163345", "01")}</span>
          <div class="tx-card-icon"><span class="material-symbols-rounded">medication</span></div>
          <h3>{edit.text("text-08ba4b09bb", "Chemotherapy")}</h3>
          <p>{edit.text("text-10a070ab90", "Systemic drug therapy that targets rapidly dividing cancer cells. Modern regimens are more effective and better tolerated than ever, with proactive side-effect management built into every plan.")}</p>
        </div>
        <div class="tx-card">
          <span class="tx-card-num">{edit.text("text-bcac9d1d8e", "02")}</span>
          <div class="tx-card-icon"><span class="material-symbols-rounded">vaccines</span></div>
          <h3>{edit.text("text-f99d76e2a8", "Immunotherapy")}</h3>
          <p>{edit.text("text-0d618543f8", "Therapies that harness your own immune system to recognize and attack cancer cells. Checkpoint inhibitors and other agents have transformed outcomes in many cancer types.")}</p>
        </div>
        <div class="tx-card">
          <span class="tx-card-num">{edit.text("text-3ea6c91e24", "03")}</span>
          <div class="tx-card-icon"><span class="material-symbols-rounded">target</span></div>
          <h3>{edit.text("text-9cc205729a", "Targeted Therapy")}</h3>
          <p>{edit.text("text-7a28a35454", "Drugs designed to attack specific genetic mutations or proteins in cancer cells while sparing healthy tissue. Molecular profiling identifies which targets your cancer expresses.")}</p>
        </div>
        <div class="tx-card">
          <span class="tx-card-num">{edit.text("text-798f861ee7", "04")}</span>
          <div class="tx-card-icon"><span class="material-symbols-rounded">balance</span></div>
          <h3>{edit.text("text-7cd9f3a474", "Hormone Therapy")}</h3>
          <p>{edit.text("text-000e1fa3d6", "Treatment that blocks or lowers hormones that fuel certain cancers, commonly used in breast and prostate cancer to slow or stop tumor growth.")}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Category 2: Imaging & Radiation (featured wide cards) -->
  <section class="tx-cat">
    <div class="container">
      <div class="tx-cat-header">
        <div class="tx-cat-header-text">
          <span class="tx-eyebrow">{edit.text("text-ad375cb78f", "Imaging & precision radiation")}</span>
          <h2 class="tx-cat-heading">{edit.text("text-d802926348", "Pinpoint accuracy. Maximum precision.")}</h2>
          <p class="tx-cat-sub">{edit.text("text-e826ac4b18", "Image-guided technology that sees more, exposes less, and treats with millimeter accuracy.")}</p>
        </div>
        <div class="tx-cat-meta">{edit.text("text-9a1c155562", "02 platforms")}</div>
      </div>

      <div class="tx-grid-2">
        <div class="tx-card tx-card--feat">
          <div class="tx-card-icon"><span class="material-symbols-rounded">radiology</span></div>
          <div>
            <h3>{edit.text("text-ae5945f942", "Radiation Therapy")}</h3>
            <p>{edit.text("text-a8a3a420e1", "Precise, image-guided radiation using the TrueBeam Linear Accelerator — delivered with millimeter accuracy and gated respiration synchronization for motion-sensitive tumors.")}</p>
            <div class="tx-feat-tags">
              <span class="tx-feat-tag"><span class="material-symbols-rounded">blur_circular</span>{edit.text("text-cbfdd31311", " IMRT")}</span>
              <span class="tx-feat-tag"><span class="material-symbols-rounded">radar</span>{edit.text("text-4167562736", " SBRT & SRS")}</span>
              <span class="tx-feat-tag"><span class="material-symbols-rounded">target</span>{edit.text("text-bb7d7bae3b", " IGRT")}</span>
              <span class="tx-feat-tag"><span class="material-symbols-rounded">science</span>{edit.text("text-6d74bd75cd", " Brachytherapy")}</span>
            </div>
          </div>
        </div>
        <div class="tx-card tx-card--feat">
          <div class="tx-card-icon"><span class="material-symbols-rounded">monitor_heart</span></div>
          <div>
            <h3>{edit.text("text-fb25747d5b", "Diagnostic Imaging")}</h3>
            <p>{edit.text("text-14d361c327", "The Omni Legend Digital PET/CT scanner delivers AI-powered, low-dose imaging with industry-leading sensitivity for precise diagnosis, staging, and treatment monitoring.")}</p>
            <div class="tx-feat-tags">
              <span class="tx-feat-tag"><span class="material-symbols-rounded">science</span>{edit.text("text-507296094e", " FDG")}</span>
              <span class="tx-feat-tag"><span class="material-symbols-rounded">science</span>{edit.text("text-490f0e03e7", " Ga68 PSMA")}</span>
              <span class="tx-feat-tag"><span class="material-symbols-rounded">science</span>{edit.text("text-48ec8c94ca", " F18 PSMA")}</span>
              <span class="tx-feat-tag"><span class="material-symbols-rounded">science</span>{edit.text("text-79595ce582", " Axumin")}</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Category 3: Research & Comprehensive Care -->
  <section class="tx-cat tx-cat--gray">
    <div class="container">
      <div class="tx-cat-header">
        <div class="tx-cat-header-text">
          <span class="tx-eyebrow">{edit.text("text-8a16e5412a", "Research & comprehensive care")}</span>
          <h2 class="tx-cat-heading">{edit.text("text-5465dbfc97", "Beyond the standard of care.")}</h2>
          <p class="tx-cat-sub">{edit.text("text-c5ff6c5c9f", "Access to investigational therapies, expert hematology, and whole-person support throughout your journey.")}</p>
        </div>
        <div class="tx-cat-meta">{edit.text("text-97598b8f50", "03 programs")}</div>
      </div>

      <div class="tx-grid-3">
        <div class="tx-card">
          <span class="tx-card-num">{edit.text("text-39f193cfd7", "07")}</span>
          <div class="tx-card-icon"><span class="material-symbols-rounded">science</span></div>
          <h3>{edit.text("text-65221b74ce", "Clinical Trials")}</h3>
          <p>{edit.text("text-90710d0283", "Access to investigational treatments through 50+ active trials, including Utah’s only community-based early-phase program (START Mountain Region).")}</p>
        </div>
        <div class="tx-card">
          <span class="tx-card-num">{edit.text("text-1ea51bf324", "08")}</span>
          <div class="tx-card-icon"><span class="material-symbols-rounded">self_improvement</span></div>
          <h3>{edit.text("text-70c65d21f7", "Supportive Care")}</h3>
          <p>{edit.text("text-9ebc284b15", "Symptom management, pain control, nutrition counseling, and rehabilitative care — addressing the physical and emotional side effects of treatment.")}</p>
        </div>
        <div class="tx-card">
          <span class="tx-card-num">{edit.text("text-4b581cdce6", "09")}</span>
          <div class="tx-card-icon"><span class="material-symbols-rounded">bloodtype</span></div>
          <h3>{edit.text("text-e9bac92969", "Hematology")}</h3>
          <p>{edit.text("text-ba9096f137", "Expert diagnosis and treatment of blood cancers and benign blood disorders including anemia, clotting disorders, and bone marrow conditions.")}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Personalized plan band -->
  <section class="tx-plan">
    <div class="container">
      <div class="tx-plan-inner">
        <div>
          <span class="tx-plan-eyebrow">{edit.text("text-d7caa375d0", "How we build your plan")}</span>
          <h2 class="tx-plan-title">{edit.text("text-003ae90f99", "Your treatment is as unique as you are.")}</h2>
          <p class="tx-plan-desc">{edit.text("text-f2baff850c", "No two cancers — or patients — are alike. Your plan is shaped by your diagnosis, biology, history, and personal goals, then continually refined as your care progresses.")}</p>
        </div>
        <div class="tx-plan-steps">
          <div class="tx-plan-step">
            <div class="tx-plan-step-num">{edit.text("text-356a192b79", "1")}</div>
            <div class="tx-plan-step-text">
              <h3>{edit.text("text-264e0cc221", "Confirm the diagnosis")}</h3>
              <p>{edit.text("text-3d45775b8c", "Pathology, imaging, and molecular profiling establish cancer type, stage, and the genetic markers that guide treatment.")}</p>
            </div>
          </div>
          <div class="tx-plan-step">
            <div class="tx-plan-step-num">{edit.text("text-da4b9237ba", "2")}</div>
            <div class="tx-plan-step-text">
              <h3>{edit.text("text-594390fa11", "Multidisciplinary review")}</h3>
              <p>{edit.text("text-f20a15bff5", "Medical oncologists, radiation oncologists, and specialists discuss your case together to recommend the strongest options.")}</p>
            </div>
          </div>
          <div class="tx-plan-step">
            <div class="tx-plan-step-num">{edit.text("text-77de68daec", "3")}</div>
            <div class="tx-plan-step-text">
              <h3>{edit.text("text-6d56179a83", "Tailor the modalities")}</h3>
              <p>{edit.text("text-91d4c61d26", "The right combination — chemotherapy, radiation, immunotherapy, targeted drugs, or trial enrollment — chosen for you.")}</p>
            </div>
          </div>
          <div class="tx-plan-step">
            <div class="tx-plan-step-num">{edit.text("text-1b64538924", "4")}</div>
            <div class="tx-plan-step-text">
              <h3>{edit.text("text-b30f899314", "Treat & support")}</h3>
              <p>{edit.text("text-046eba6dbf", "Side-effect management, nutrition, and emotional support are built into your plan from day one and adjusted as you go.")}</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
